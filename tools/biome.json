{
  "id": "biome",
  "name": "Biome",
  "language": "js",
  "ext": "js",
  "repo": "biomejs/biome",
  "sandboxImage": "node:20-slim",
  "docsFence": "js",
  "vars": {
    "BIOME": {
      "env": "FIXHUNT_BIOME",
      "default": "bunx --bun @biomejs/biome",
      "split": true
    }
  },
  "version": {
    "cmd": [
      "{BIOME}",
      "--version"
    ],
    "stripPrefix": "^Version:\\s*"
  },
  "rule": {
    "split": "^(?:(?<group>[\\w-]+)/)?(?<short>[\\w-]+)$",
    "cmd": [
      "{BIOME}",
      "explain",
      "{rule.short}"
    ],
    "idFromOutput": "Diagnostic category:\\s*lint/([\\w/-]+)",
    "fixKind": {
      "regex": "^- Fix:\\s*(\\w+)",
      "map": {
        "safe": "safe",
        "unsafe": "unsafe"
      },
      "default": "none",
      "onError": "unknown"
    }
  },
  "lint": {
    "cmd": [
      "{BIOME}",
      "lint",
      "--only={rule}",
      "--reporter=json",
      "--max-diagnostics=200",
      "{file}"
    ],
    "parse": {
      "format": "json",
      "items": "diagnostics",
      "rule": "category",
      "rulePrefix": "lint/",
      "message": "message",
      "severity": "severity",
      "span": "location.span",
      "nonJsonOk": "Checked \\d+ file"
    },
    "crash": {
      "okExit": [
        0,
        1
      ],
      "stderrRegex": "panicked|RUST_BACKTRACE|internal error"
    }
  },
  "fix": {
    "cmd": [
      "{BIOME}",
      "lint",
      "--only={rule}",
      "--write",
      "{file}"
    ],
    "unsafeArgs": [
      "--unsafe"
    ],
    "crash": {
      "okExit": [
        0,
        1
      ],
      "stderrRegex": "panicked|RUST_BACKTRACE|internal error"
    }
  },
  "check": {
    "cmd": [
      "node",
      "--check",
      "{file}"
    ],
    "timeoutMs": 10000
  },
  "run": {
    "cmd": [
      "node",
      "--stack-size=2000",
      "{file}"
    ],
    "env": {
      "NODE_OPTIONS": ""
    },
    "timeoutMs": 5000
  },
  "repro": [
    "node {file}",
    "bunx @biomejs/biome lint --only={rule} --write{unsafe} {file}",
    "node {file}"
  ],
  "catalog": {
    "cmd": [
      "bun",
      "tools/biome.catalog.ts"
    ],
    "parse": {
      "items": "$",
      "rule": "rule",
      "name": "name",
      "fixKind": "fixKind",
      "languages": "languages",
      "recommended": "recommended"
    }
  },
  "sweep": {
    "fixKinds": [
      "safe"
    ],
    "languages": [
      "js"
    ]
  },
  "config": {
    "files": [
      "biome.json",
      "biome.jsonc"
    ],
    "format": "json",
    "rules": "linter.rules",
    "default": "recommended"
  }
}
