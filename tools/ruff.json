{
  "id": "ruff",
  "name": "ruff",
  "language": "py",
  "ext": "py",
  "repo": "astral-sh/ruff",
  "sandboxImage": "python:3.12-slim",
  "docsFence": "python",
  "vars": {
    "RUFF": {
      "env": "FIXHUNT_RUFF",
      "default": "uvx ruff@0.17.1",
      "split": true
    },
    "PYTHON": {
      "env": "FIXHUNT_PYTHON",
      "candidates": [
        "python3",
        "python"
      ],
      "default": "python3"
    }
  },
  "version": {
    "cmd": [
      "{RUFF}",
      "--version"
    ]
  },
  "rule": {
    "upper": true,
    "cmd": [
      "{RUFF}",
      "rule",
      "{rule}"
    ],
    "fixKind": {
      "regex": "^Fix is (\\w+) available",
      "map": {
        "not": "none",
        "always": "unknown",
        "sometimes": "unknown"
      },
      "default": "unknown"
    }
  },
  "lint": {
    "cmd": [
      "{RUFF}",
      "check",
      "--preview",
      "--isolated",
      "--no-cache",
      "--select={rule}",
      "--output-format=json",
      "--exit-zero",
      "{file}"
    ],
    "parse": {
      "format": "json",
      "items": "$",
      "rule": "code",
      "message": "message",
      "line": "location.row",
      "col": "location.column",
      "fix": "fix.applicability",
      "fixMap": {
        "safe": "safe",
        "unsafe": "unsafe",
        "display-only": "none"
      },
      "fixPresent": "fix"
    },
    "crash": {
      "okExit": [
        0,
        1
      ],
      "stderrRegex": "panicked|RUST_BACKTRACE|error: Failed|Ruff crashed"
    }
  },
  "fix": {
    "cmd": [
      "{RUFF}",
      "check",
      "--preview",
      "--isolated",
      "--no-cache",
      "--select={rule}",
      "--fix",
      "--exit-zero",
      "--quiet",
      "{file}"
    ],
    "unsafeArgs": [
      "--unsafe-fixes"
    ],
    "crash": {
      "okExit": [
        0,
        1
      ],
      "stderrRegex": "panicked|RUST_BACKTRACE|error: Failed|Ruff crashed"
    }
  },
  "check": {
    "cmd": [
      "{PYTHON}",
      "-I",
      "-c",
      "import ast,sys; ast.parse(open(sys.argv[1], encoding='utf8').read(), sys.argv[1])",
      "{file}"
    ],
    "timeoutMs": 15000
  },
  "run": {
    "cmd": [
      "python3",
      "-I",
      "-X",
      "utf8",
      "{file}"
    ],
    "env": {
      "PYTHONHASHSEED": "0",
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "timeoutMs": 5000
  },
  "repro": [
    "python3 {file}",
    "ruff check --preview --isolated --select {rule} --fix{unsafe} {file}",
    "python3 {file}"
  ],
  "catalog": {
    "cmd": [
      "{RUFF}",
      "rule",
      "--all",
      "--output-format",
      "json"
    ],
    "parse": {
      "items": "$",
      "rule": "code",
      "name": "name",
      "note": "fix",
      "languages": [
        "py"
      ],
      "fixKindFrom": {
        "field": "fix",
        "map": [
          {
            "regex": "not available",
            "kind": "none"
          }
        ],
        "default": "unknown"
      },
      "skipIf": [
        {
          "field": "status",
          "regex": "removed"
        },
        {
          "field": "explanation",
          "regex": "^## Removed|^This rule has been removed"
        }
      ]
    }
  },
  "sweep": {
    "fixKinds": [
      "unknown",
      "safe"
    ],
    "requireNoteRegex": "always",
    "skipRuleRegex": "^(E[1-5]|W[1-5]|D[1-4]|Q|COM|I|PYI|TD|PT|AIR|FAST|FA|EXE|ANN|CPY|DJ|INP|ERA)"
  },
  "config": {
    "files": [
      ".ruff.toml",
      "ruff.toml",
      "pyproject.toml"
    ],
    "format": "toml",
    "root": {
      "pyproject.toml": "tool.ruff"
    },
    "select": [
      "lint.select",
      "select"
    ],
    "extend": [
      "lint.extend-select",
      "extend-select"
    ],
    "ignore": [
      "lint.ignore",
      "ignore"
    ],
    "default": [
      "E4",
      "E7",
      "E9",
      "F"
    ],
    "families": [
      "PL"
    ]
  }
}
