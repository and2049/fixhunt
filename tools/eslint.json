{
  "id": "eslint",
  "name": "ESLint",
  "language": "js",
  "ext": "js",
  "repo": "eslint/eslint",
  "sandboxImage": "node:20-slim",
  "docsFence": "js",
  "vars": {
    "ESLINT": {
      "env": "FIXHUNT_ESLINT",
      "default": "bunx eslint",
      "split": true
    }
  },
  "version": {
    "cmd": [
      "{ESLINT}",
      "--version"
    ],
    "stripPrefix": "^v"
  },
  "rule": {
    "cmd": [
      "bun",
      "tools/eslint.rule.ts",
      "{rule}"
    ],
    "fixKind": {
      "regex": "^Fixable: (\\w+)",
      "map": {
        "code": "safe",
        "whitespace": "safe",
        "no": "none"
      },
      "default": "unknown"
    },
    "docs": {
      "url": "https://raw.githubusercontent.com/eslint/eslint/main/docs/src/rules/{rule}.md"
    }
  },
  "lint": {
    "cmd": [
      "{ESLINT}",
      "--no-config-lookup",
      "--rule",
      "{rule}: error",
      "--format",
      "json",
      "{file}"
    ],
    "parse": {
      "format": "json",
      "items": "0.messages",
      "rule": "ruleId",
      "message": "message",
      "line": "line",
      "col": "column",
      "fix": "fix.kind",
      "fixPresent": "fix",
      "fixPresentKind": "safe"
    },
    "crash": {
      "okExit": [
        0,
        1
      ],
      "stderrRegex": "Oops! Something went wrong|TypeError|RangeError"
    }
  },
  "fix": {
    "cmd": [
      "{ESLINT}",
      "--no-config-lookup",
      "--rule",
      "{rule}: error",
      "--fix",
      "{file}"
    ],
    "crash": {
      "okExit": [
        0,
        1
      ],
      "stderrRegex": "Oops! Something went wrong|TypeError|RangeError"
    }
  },
  "check": {
    "cmd": [
      "node",
      "--check",
      "{file}"
    ],
    "timeoutMs": 10000
  },
  "run": {
    "cmd": [
      "node",
      "--stack-size=2000",
      "{file}"
    ],
    "env": {
      "NODE_OPTIONS": ""
    },
    "timeoutMs": 5000
  },
  "repro": [
    "node {file}",
    "npx eslint --no-config-lookup --rule '{rule}: error' --fix {file}",
    "node {file}"
  ],
  "catalog": {
    "cmd": [
      "bun",
      "tools/eslint.catalog.ts"
    ],
    "parse": {
      "items": "$",
      "rule": "rule",
      "name": "rule",
      "fixKind": "fixKind",
      "note": "note",
      "languages": [
        "js"
      ],
      "skipIf": [
        {
          "field": "deprecated",
          "regex": "^true$"
        }
      ]
    }
  },
  "sweep": {
    "fixKinds": [
      "safe"
    ],
    "requireNoteRegex": "^code"
  },
  "config": {
    "files": [
      "eslint.config.js",
      "eslint.config.mjs",
      "eslint.config.cjs",
      "eslint.config.ts"
    ],
    "format": "opaque",
    "note": "ESLint configuration is code and is not read; every rule with a finding is listed"
  }
}
