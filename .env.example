# Nebius Token Factory (shipped default provider)
NEBIUS_API_KEY=            # create at https://tokenfactory.nebius.com/project/api-keys
NEBIUS_PROJECT_ID=aiproject-e00ts1jph93mrv7bpj   # default-project; needed for Sandboxes
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Tavily (dedup stage)
TAVILY_API_KEY=
# Where generated programs run: auto (Token Factory Sandboxes when the key has access, else bwrap), contree, bwrap
FIXHUNT_SANDBOX=auto
# Programs evaluated concurrently per hunt round (sandbox limit is 50 operations)
FIXHUNT_PARALLEL=6
# Repository scans: findings per scan that are minimized, judged, searched and written up; sandbox runs per minimization
# FIXHUNT_SCAN_FINDINGS=10
# FIXHUNT_SCAN_MINIMIZE=20
# Tools offered for repository scans from the dashboard; unset means all loaded tools
# FIXHUNT_SCAN_TOOLS=ruff,biome
# Hosted dashboard: access codes with a daily USD budget each (unset means live actions are open to anyone),
# global USD cap per UTC day (default 10), optional bearer token required on every POST
# FIXHUNT_ACCESS=judges:5,public:0.5
# FIXHUNT_DAILY_CAP=10
# FIXHUNT_TOKEN=
# Live-action limits: concurrent re-runs, programs and rounds per hunt, rules per scan (default 30), seconds per sandbox run (default 300),
# hosts a repository may be cloned from (default github.com,gitlab.com,codeberg.org,bitbucket.org), checkout size cap in MB (default 50)
# FIXHUNT_MAX_RERUNS=2  FIXHUNT_MAX_N=10  FIXHUNT_MAX_ROUNDS=2  FIXHUNT_SCAN_LIMIT=30  FIXHUNT_SCAN_TIMEOUT=300
# FIXHUNT_CLONE_HOSTS=github.com,gitlab.com  FIXHUNT_MAX_ARCHIVE_MB=50
# Repository the worked example scans on the home page point at (its demo/repo directory is scanned)
# FIXHUNT_DEMO_REPO=https://github.com/and2049/fixhunt
