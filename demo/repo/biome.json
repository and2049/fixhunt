{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["web/**"] },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useNumberNamespace": "error",
        "noUselessElse": "error",
        "noNegationElse": "error",
        "useTemplate": "error",
        "useConst": "error"
      },
      "complexity": { "noUselessLoneBlockStatements": "error" }
    }
  }
}
