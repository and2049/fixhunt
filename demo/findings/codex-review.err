     9	
    10	function runDirs(only?: string) {
    11	  return readdirSync(RUNS_DIR).filter((d) => existsSync(join(RUNS_DIR, d, "results.json")) && (!only || d.includes(only))).sort();
    12	}
    13	
    14	export async function reprocess(tools: Record<string, Tool>, opts: { only?: string; force?: boolean }) {
    15	  for (const d of runDirs(opts.only)) {
    16	    const dir = join(RUNS_DIR, d);
    17	    const run = JSON.parse(readFileSync(join(dir, "results.json"), "utf8"));
    18	    const tool = tools[run.tool];
    19	    if (!tool) continue;
    20	    const hits = run.results.filter((r: any) => r.findings.some((f: any) => f.kind !== "disputed"));
    21	    if (!hits.length) continue;
    22	    const judged = (run.reports ?? []).filter((r: any) => r.verdict).length;
    23	    if (!opts.force && judged === hits.length) continue;
    24	    console.log(`${d}: ${hits.length} finding(s), ${judged} judged`);
    25	    const pf = await processFindings(tool, run.rule, run.version, dir, run.results, run.opts?.unsafe ?? false, run.reports ?? []);
    26	    run.reports = pf.reports;
    27	    run.cost = (run.cost ?? 0) + pf.cost;
    28	    writeFileSync(join(dir, "results.json"), JSON.stringify(run, null, 2));
    29	  }
    30	}
