    93	export type Spend = { total: number; byModel: Record<string, { calls: number; cost: number; prompt: number; completion: number }>; byTag: Record<string, { calls: number; cost: number }> };
    94	
    95	export function spend(): Spend {
    96	  const s: Spend = { total: 0, byModel: {}, byTag: {} };
    97	  const f = join(RUNS_DIR, "spend.jsonl");
    98	  if (!existsSync(f)) return s;
    99	  for (const line of readFileSync(f, "utf8").split("\n")) {
   100	    if (!line.trim()) continue;
   101	    try {
   102	      const j = JSON.parse(line);
   103	      s.total += j.cost ?? 0;
   104	      const m = (s.byModel[j.model] ??= { calls: 0, cost: 0, prompt: 0, completion: 0 });
   105	      m.calls++; m.cost += j.cost ?? 0; m.prompt += j.prompt ?? 0; m.completion += j.completion ?? 0;
   106	      const t = (s.byTag[j.tag ?? "?"] ??= { calls: 0, cost: 0 });
   107	      t.calls++; t.cost += j.cost ?? 0;
   108	    } catch { /* skip */ }
   109	  }
   110	  return s;
   111	}
   112	
   113	export type Stats = {
   114	  runs: number; tools: string[]; rules: number; programs: number; fired: number; fixed: number; findings: number; safeFindings: number;
   115	  grades: Record<string, number>; kinds: Record<string, number>; curated: Record<string, number>; versions: Record<string, string>; cost: number;
   116	  sandboxRuns: number; sandboxCost: number;
   117	};
   118	
   119	export function stats(runs = loadRuns(), fs = findings(runs), curated = loadCurated()): Stats {
   120	  const sp = spend();
   121	  const st: Stats = { runs: runs.length, tools: [], rules: 0, programs: 0, fired: 0, fixed: 0, findings: fs.length, safeFindings: 0, grades: {}, kinds: {}, curated: {}, versions: {}, cost: 0, sandboxRuns: sp.byTag.sandbox?.calls ?? 0, sandboxCost: sp.byTag.sandbox?.cost ?? 0 };
   122	  const rules = new Set<string>();
   123	  for (const r of runs) {
   124	    rules.add(`${r.tool} ${r.rule.rule}`);
   125	    st.programs += r.summary.programs ?? 0; st.fired += r.summary.fired ?? 0; st.fixed += r.summary.fixed ?? 0; st.cost += r.cost;
   126	    st.versions[r.tool] ??= r.version;
   127	    if (!st.tools.includes(r.tool)) st.tools.push(r.tool);
   128	  }
   129	  st.rules = rules.size;
   130	  for (const f of fs) {
   131	    st.grades[f.grade] = (st.grades[f.grade] ?? 0) + 1;
   132	    st.kinds[f.report.kind] = (st.kinds[f.report.kind] ?? 0) + 1;
   133	    if (f.report.safeLabel) st.safeFindings++;
   134	  }
   135	  for (const c of curated) st.curated[c.status] = (st.curated[c.status] ?? 0) + 1;
   136	  return st;
   137	}
   138	
   139	export function catalogRules(toolIds: string[]): Record<string, Array<{ rule: string; fixKind: string }>> {
   140	  const out: Record<string, Array<{ rule: string; fixKind: string }>> = {};
   141	  for (const t of toolIds) {
   142	    try { out[t] = JSON.parse(readFileSync(`data/${t}-rules.json`, "utf8")).filter((r: any) => r.fixKind !== "none").map((r: any) => ({ rule: r.rule, fixKind: r.fixKind })); } catch { out[t] = []; }
   143	  }
   144	  return out;
   145	}
