    86	function collect(stream: ReadableStream<Uint8Array>): { done: Promise<void>; text: () => string } {
    87	  const chunks: Uint8Array[] = [];
    88	  const done = (async () => {
    89	    const reader = stream.getReader();
    90	    try {
    91	      for (;;) {
    92	        const { value, done } = await reader.read();
    93	        if (done) break;
    94	        if (value) chunks.push(value);
    95	      }
    96	    } catch {}
    97	  })();
    98	  return { done, text: () => new TextDecoder().decode(concat(chunks)) };
    99	}
   100	
   101	function concat(chunks: Uint8Array[]): Uint8Array {
   102	  const n = chunks.reduce((a, c) => a + c.length, 0);
   103	  const out = new Uint8Array(n);
   104	  let o = 0;
   105	  for (const c of chunks) { out.set(c, o); o += c.length; }
   106	  return out;
   107	}
