    56	  const timeout = Math.max(1, Math.ceil((o.timeoutMs ?? 5000) / 1000));
    57	  const body = {
    58	    image: o.image.startsWith("tag:") || /^[0-9a-f-]{36}$/.test(o.image) ? o.image : `tag:${o.image}`,
    59	    command, shell: true, disposable: true, timeout, env: o.env ?? {},
    60	    networking: { enabled: !!o.net }, truncate_output_at: Math.min(10 * 1024 * 1024, Math.max(65536, (o.maxOutput ?? 65536) * 2)),
    61	    stdin: { value: tarb64, encoding: "ascii", close: true },
    62	  };
    63	  let opId = "";
    64	  for (let attempt = 0; ; attempt++) {
    65	    const r = await fetch(`${BASE}/instances`, { method: "POST", headers: headers(), body: JSON.stringify(body), signal: AbortSignal.timeout(60_000) });
