    39	/** Tar `cwd` (regular files only, or the whole tree with `recursive`) and return it base64-encoded. */
    40	async function packDir(cwd: string, recursive = false, exclude: string[] = []): Promise<string> {
    41	  const files = recursive ? ["."] : readdirSync(cwd).filter((f) => { try { return statSync(join(cwd, f)).isFile(); } catch { return false; } });
    42	  if (!files.length) return "";
    43	  const p = Bun.spawn(["tar", "cz", "-C", cwd, ...exclude.flatMap((e) => ["--exclude", e]), ...(recursive ? [] : ["--no-recursion"]), "--", ...files], { stdout: "pipe", stderr: "pipe" });
    44	  const buf = Buffer.from(await new Response(p.stdout).arrayBuffer());
    45	  if ((await p.exited) !== 0) throw new Error("tar failed: " + (await new Response(p.stderr).text()));
    46	  return buf.toString("base64");
    47	}
