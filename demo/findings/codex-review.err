    49	export type SandboxOpts = { image: string; cwd: string; env?: Record<string, string>; timeoutMs?: number; maxOutput?: number; net?: boolean; recursive?: boolean; exclude?: string[] };
    50	
    51	/** Run `cmd` in `image` with the files of `cwd` unpacked into /w. Throws on infrastructure failure. */
    52	export async function runInSandbox(cmd: string[], o: SandboxOpts): Promise<ExecResult & { cost: number; opId: string }> {
    53	  const tarb64 = await packDir(resolve(o.cwd), o.recursive, o.exclude);
