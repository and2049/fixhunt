    56	.tag.acc{color:var(--acc);border-color:color-mix(in srgb,var(--acc) 50%,transparent);background:color-mix(in srgb,var(--acc) 10%,transparent)}
    57	.tag.vio{color:var(--vio);border-color:color-mix(in srgb,var(--vio) 50%,transparent);background:color-mix(in srgb,var(--vio) 10%,transparent)}
    58	table.tbl{border-collapse:collapse;width:100%;font-size:13.5px}
    59	.tbl th{text-align:left;color:var(--mut);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.4px;padding:8px;border-bottom:1px solid var(--line)}
    60	.tbl td{padding:8px;border-bottom:1px solid var(--line);vertical-align:top}
    61	.tbl td:last-child{min-width:260px}
    62	.tbl tr:hover td{background:var(--panel2)}
    63	.tbl td.num{color:var(--mut);text-align:right;font-variant-numeric:tabular-nums}
    64	.chips{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 14px}
    65	.chip{border:1px solid var(--line);background:var(--panel);color:var(--mut);border-radius:999px;padding:3px 11px;font-size:12.5px;cursor:pointer}
    66	.chip.on{color:var(--fg);border-color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,transparent)}
    67	.cur{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px}
    68	.cur .card{margin:0;display:flex;flex-direction:column;gap:6px}
    69	.cur .card .t{font-weight:600;font-size:15px}
    70	.cur .card .s{color:var(--mut);font-size:13.5px;flex:1}
    71	.cur .card .f{font-size:12.5px;color:var(--mut)}
    72	pre.code,.code{background:var(--panel2);border:1px solid var(--line);border-radius:8px;overflow:auto;font-size:12.5px;line-height:1.5;margin:6px 0}
    73	pre.code{padding:10px 12px;white-space:pre}
    74	.code .ln{display:grid;grid-template-columns:2.6em 1fr;white-space:pre}
    75	.code .ln>i{color:var(--mut);text-align:right;padding:0 .8em 0 .4em;user-select:none;font-style:normal;opacity:.7}
    76	.code .ln>s{text-decoration:none;padding-right:12px}
    77	.code .ln.del{background:var(--del)}.code .ln.add{background:var(--add)}.code .ln.gap{background:repeating-linear-gradient(135deg,transparent 0 6px,var(--line) 6px 7px);min-height:1.5em}
    78	.sbs{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    79	.sbs>div>h3{margin-top:0}
    80	@media(max-width:860px){.sbs{grid-template-columns:1fr}}
    81	.out{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    82	@media(max-width:860px){.out{grid-template-columns:1fr}}
    83	.kv{display:grid;grid-template-columns:max-content 1fr;gap:4px 14px;font-size:13.5px}.kv>b{color:var(--mut);font-weight:500}
    84	.diff .a{color:var(--ok)}.diff .d{color:var(--bad)}.diff .h{color:var(--acc)}
    85	details summary{cursor:pointer;color:var(--mut)}details{margin:8px 0}
    86	.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    87	.btn{display:inline-block;background:var(--acc);color:#fff;border:0;border-radius:8px;padding:8px 16px;font-size:14px;cursor:pointer;font-weight:600}
    88	.btn[disabled]{opacity:.5;cursor:default}
    89	.btn.ghost{background:transparent;color:var(--acc);border:1px solid var(--acc)}
    90	input,select{background:var(--panel2);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:7px 10px;font:inherit;font-size:14px}
    91	label.f{display:flex;flex-direction:column;gap:4px;font-size:12.5px;color:var(--mut)}
    92	.feed{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;margin-top:10px}
    93	.feed .card{margin:0;padding:12px 14px;font-size:13px}
    94	.feed .card .t{font-weight:600;font-size:13.5px;margin-bottom:2px}
    95	.feed .card.finding{border-color:var(--bad)}.feed .card.fix-ok{border-color:color-mix(in srgb,var(--ok) 50%,transparent)}
    96	.log{font-family:var(--mono);font-size:12.5px;color:var(--mut);white-space:pre-wrap}
    97	.pipe{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}
    98	.pipe .st{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:13px}
    99	.pipe .st b{display:block;font-size:12px;color:var(--mut);text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px}
   100	.pipe .st em{display:block;color:var(--vio);font-style:normal;font-size:12px;margin-top:4px}
   101	footer{border-top:1px solid var(--line);color:var(--mut);font-size:12.5px;padding:18px 0}
   102	.grade{font-weight:600}
   103	`;
   104	
   105	export function layout(o: { title: string; active: "home" | "runs" | "hunt" | "about" | "scans" | ""; L: Links; body: string; head?: string }): string {
   106	  const nl = (href: string, key: string, text: string) => `<a class="nl${o.active === key ? " on" : ""}" href="${href}">${text}</a>`;
   107	  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(o.title)}</title><style>${CSS}</style>${o.head ?? ""}</head><body>
   108	<nav class="top"><div class="wrap"><a class="brand" href="${o.L.home}">fix<span>hunt</span></a>${nl(o.L.home, "home", "Findings")}${nl(o.L.runs, "runs", "Runs")}${nl(o.L.scans, "scans", "Scans")}${nl(o.L.hunt, "hunt", "Live hunt")}${nl(o.L.about, "about", "How it works")}<span class="right">Nemotron on Nebius Token Factory</span></div></nav>
   109	<main><div class="wrap">${o.body}</div></main>
   110	<footer><div class="wrap">fixhunt · model-free oracles, Nemotron 3 analysis and judging · nothing is posted upstream by the tool</div></footer>
   111	</body></html>`;
   112	}
   113	
   114	export const tag = (text: string, cls = "") => `<span class="tag ${cls}">${esc(text)}</span>`;
   115	
   116	export function gradeTag(grade: string, severity?: string): string {
   117	  const cls = grade === "real" ? "bad" : grade === "unclear" || grade === "unjudged" ? "warn" : "";
   118	  return tag(grade === "unjudged" ? "unjudged" : severity && severity !== "-" ? `${grade} · ${severity}` : grade, cls);
   119	}
   120	export const kindTag = (kind: string) => tag(kind, kind === "fix-breaks-syntax" || kind === "tool-crash" ? "bad" : "vio");
   121	export function statusTag(status: string): string {
   122	  return status === "filed" ? tag("filed upstream", "ok") : status === "candidate" ? tag("new candidate", "acc") : status === "known" ? tag("known upstream", "") : "";
   123	}
   124	export const upstreamTag = (u: string) => (u === "duplicate" ? tag("duplicate upstream", "") : u === "related" ? tag("related upstream", "") : tag("no upstream match", "acc"));
   125	
   126	/** Plain code block with line numbers. */
   127	export function codeBlock(code: string, marks: Map<number, "del" | "add"> = new Map()): string {
   128	  const lines = code.replace(/\n$/, "").split("\n");
   129	  return `<div class="code">${lines.map((l, i) => `<div class="ln ${marks.get(i) ?? ""}"><i>${i + 1}</i><s>${esc(l) || " "}</s></div>`).join("")}</div>`;
   130	}
   131	
   132	type Op = { t: "same" | "del" | "add"; a?: string; b?: string };
   133	
   134	/** Line-level LCS diff; inputs are small (minimized programs). */
   135	export function diffLines(a: string, b: string): Op[] {
   136	  const A = a.replace(/\n$/, "").split("\n"), B = b.replace(/\n$/, "").split("\n");
   137	  const n = A.length, m = B.length;
   138	  const dp: number[][] = Array.from({ length: n + 1 }, () => new Array(m + 1).fill(0));
   139	  for (let i = n - 1; i >= 0; i--) for (let j = m - 1; j >= 0; j--) dp[i][j] = A[i] === B[j] ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
   140	  const ops: Op[] = [];
   141	  let i = 0, j = 0;
   142	  while (i < n && j < m) {
   143	    if (A[i] === B[j]) { ops.push({ t: "same", a: A[i], b: B[j] }); i++; j++; }
   144	    else if (dp[i + 1][j] >= dp[i][j + 1]) { ops.push({ t: "del", a: A[i] }); i++; }
   145	    else { ops.push({ t: "add", b: B[j] }); j++; }
   146	  }
   147	  while (i < n) ops.push({ t: "del", a: A[i++] });
   148	  while (j < m) ops.push({ t: "add", b: B[j++] });
   149	  return ops;
   150	}
   151	
   152	/** Two aligned columns: the program before the fix and after it, changed lines highlighted. */
   153	export function sideBySide(before: string, after: string, titles: [string, string] = ["Before the fix", "After the fix"]): string {
   154	  const ops = diffLines(before, after);
   155	  const left: string[] = [], right: string[] = [];
   156	  let la = 0, lb = 0;
   157	  const cell = (n: number | null, text: string | undefined, cls: string) => `<div class="ln ${cls}"><i>${n ?? ""}</i><s>${text === undefined ? "" : esc(text) || " "}</s></div>`;
   158	  let k = 0;
   159	  while (k < ops.length) {
   160	    if (ops[k].t === "same") { left.push(cell(++la, ops[k].a, "")); right.push(cell(++lb, ops[k].b, "")); k++; continue; }
   161	    const dels: Op[] = [], adds: Op[] = [];
   162	    while (k < ops.length && ops[k].t !== "same") { (ops[k].t === "del" ? dels : adds).push(ops[k]); k++; }
   163	    const rows = Math.max(dels.length, adds.length);
   164	    for (let r = 0; r < rows; r++) {
   165	      left.push(r < dels.length ? cell(++la, dels[r].a, "del") : cell(null, undefined, "gap"));
   166	      right.push(r < adds.length ? cell(++lb, adds[r].b, "add") : cell(null, undefined, "gap"));
   167	    }
   168	  }
   169	  return `<div class="sbs"><div><h3>${esc(titles[0])}</h3><div class="code">${left.join("")}</div></div><div><h3>${esc(titles[1])}</h3><div class="code">${right.join("")}</div></div></div>`;
   170	}
   171	
   172	function snapHtml(s: Snap | undefined, title: string): string {
   173	  if (!s) return `<div><h3>${esc(title)}</h3><pre class="code">(not run)</pre></div>`;
   174	  const status = s.timedOut ? "timed out" : `exit ${s.code}`;
   175	  const body = [s.stdout.trimEnd() || "(no stdout)", s.stderr1 ? `\n${s.stderr1}` : ""].join("");
   176	  return `<div><h3>${esc(title)} <span class="tag ${s.code === 0 && !s.timedOut ? "ok" : "bad"}">${esc(status)}</span></h3><pre class="code">${esc(body)}</pre></div>`;
   177	}
   178	
   179	export function outputPair(before: Snap, after?: Snap): string {
   180	  return `<div class="out">${snapHtml(before, "Output before")}${snapHtml(after, "Output after")}</div>`;
   181	}
   182	
   183	export function unifiedDiff(d: string): string {
   184	  return `<pre class="code diff">${d.split("\n").map((l) => (l.startsWith("+++") || l.startsWith("---") ? `<span class="h">${esc(l)}</span>` : l.startsWith("@@") ? `<span class="h">${esc(l)}</span>` : l.startsWith("+") ? `<span class="a">${esc(l)}</span>` : l.startsWith("-") ? `<span class="d">${esc(l)}</span>` : esc(l))).join("\n")}</pre>`;
   185	}
   186	
   187	export const money = (n: number) => (n < 0.01 ? `$${n.toFixed(4)}` : `$${n.toFixed(2)}`);
   188	export const when = (iso: string) => iso.replace("T", " ").slice(0, 16) + " UTC";
   189	export const issueLabel = (url: string) => url.replace(/^https:\/\/github\.com\//, "").replace(/\/(issues|pull)\//, "#");
     1	// Dashboard pages. Each returns a full HTML document; links go through `Links` so the same pages work served live or exported statically.
     2	import type { Curated, Finding, Run, Scan, Spend, Stats } from "./data";
     3	import { MODELS } from "../config";
     4	import { codeBlock, esc, gradeTag, issueLabel, kindTag, layout, money, outputPair, sideBySide, statusTag, tag, unifiedDiff, upstreamTag, when, type Links } from "./html";
     5	
     6	const KIND_TITLE: Record<string, string> = { "fix-changes-behavior": "fix changes program behavior", "fix-breaks-syntax": "fixed output does not parse", "fix-not-fixpoint": "fix is not a fixpoint", "fix-introduces-diagnostic": "fix introduces new diagnostics", "tool-crash": "tool crashes" };
     7	const kindTitle = (k: string) => KIND_TITLE[k] ?? k;
     8	const ruleLabel = (r: Run) => `${r.tool} ${r.rule.rule}`;
     9	/** "ruff 0.17.1", "biome 2.5.15": ruff's version string already starts with the tool name. */
    10	const toolVersion = (r: Run) => (r.version.toLowerCase().startsWith(r.tool.toLowerCase()) ? r.version : `${r.tool} ${r.version}`);
    11	
    12	export function landing(st: Stats, fs: Finding[], curated: Curated[], L: Links): string {
    13	  const firstFor = (c: Curated) => fs.find((f) => f.curated === c);
    14	  const cards = curated.map((c) => {
    15	    const f = firstFor(c);
    16	    return `<div class="card"><div class="row"><span class="mut small">${esc(c.tool)} ${esc(c.rule)}</span>${statusTag(c.status)}</div><div class="t">${esc(c.title)}</div><div class="s">${inline(c.summary)}</div>
    17	<div class="f">${c.issue ? `<a href="${esc(c.issue)}">${esc(issueLabel(c.issue))}</a> · ` : ""}${c.examples.map((e) => `<a href="${L.example(e)}">${esc(e.replace(/^examples\//, ""))}</a>`).join(" · ")}${f ? ` · <a href="${L.finding(f.run.id, f.report.programId)}">sweep finding</a>` : ""}</div></div>`;
    18	  }).join("");
    19	  const rows = fs.map((f) => `<tr data-tool="${esc(f.run.tool)}" data-grade="${esc(f.grade)}" data-kind="${esc(f.report.kind)}" data-safe="${f.report.safeLabel ? 1 : 0}" data-up="${esc(f.upstream)}">
    20	<td class="num">${f.rank}</td><td>${esc(f.run.tool)}</td><td><a href="${L.finding(f.run.id, f.report.programId)}">${esc(f.run.rule.rule)}</a></td><td>${kindTag(f.report.kind)}</td><td>${f.report.safeLabel ? tag("safe", "warn") : tag("unsafe")}</td><td>${gradeTag(f.grade, f.severity)}</td><td>${f.curated ? statusTag(f.curated.status) : upstreamTag(f.upstream)}</td><td class="mut">${esc(trunc(f.report.verdict?.why ?? f.result.title, 140))}</td></tr>`).join("");
    21	  const gradeCounts = Object.entries(st.grades).sort((a, b) => b[1] - a[1]);
    22	  const body = `<h1>Linter autofixes that silently change what your program does</h1>
    23	<p class="lead">fixhunt asks Nemotron for programs that sit on the semantic edges of a lint rule, applies the tool's own "safe" fix, and runs the program before and after. A finding is a different output, exit code or parse failure. Nothing here depends on a model's opinion; the model only steers the search and explains what it found.</p>
    24	<div class="stats">
    25	<div class="stat"><b>${st.rules}</b><span>rules hunted across ${st.tools.join(", ")}</span></div>
    26	<div class="stat"><b>${st.programs}</b><span>generated programs run</span></div>
    27	<div class="stat"><b>${st.findings}</b><span>oracle-backed findings</span></div>
    28	<div class="stat"><b>${st.safeFindings}</b><span>from fixes labelled safe</span></div>
    29	<div class="stat"><b>${(st.curated.filed ?? 0) + (st.curated.candidate ?? 0)}</b><span>new bugs confirmed by hand</span></div>
    30	<div class="stat"><b>${st.sandboxRuns}</b><span>runs in Token Factory Sandboxes</span></div>
    31	<div class="stat"><b>${money(st.cost + st.sandboxCost)}</b><span>total spend, models and sandboxes</span></div>
    32	</div>
    33	<h2>Confirmed by hand</h2>
    34	<p class="mut small">Each of these was re-verified with a hand-written program outside the pipeline and searched upstream. Issues are filed by a person, in their own words.</p>
    35	<div class="cur">${cards}</div>
    36	<h2>All oracle-backed findings</h2>
    37	<p class="mut small">Ranked: hand-confirmed first, then the judge's grade (Nemotron 3 Ultra, advisory) and severity. ${gradeCounts.map(([g, n]) => `${n} ${g}`).join(" · ")}.</p>
    38	<div class="chips" id="chips">
    39	<button class="chip on" data-k="tool" data-v="">all tools</button>${st.tools.map((t) => `<button class="chip" data-k="tool" data-v="${esc(t)}">${esc(t)}</button>`).join("")}
    40	<span style="width:10px"></span>
    41	<button class="chip on" data-k="grade" data-v="">all grades</button>${gradeCounts.map(([g]) => `<button class="chip" data-k="grade" data-v="${esc(g)}">${esc(g)}</button>`).join("")}
    42	<span style="width:10px"></span>
    43	<button class="chip on" data-k="safe" data-v="">any label</button><button class="chip" data-k="safe" data-v="1">labelled safe</button>
    44	<span style="width:10px"></span>
    45	<button class="chip on" data-k="up" data-v="">any upstream</button><button class="chip" data-k="up" data-v="none">no upstream match</button>
    46	</div>
    47	<table class="tbl" id="ft"><thead><tr><th>#</th><th>tool</th><th>rule</th><th>oracle</th><th>label</th><th>judge</th><th>status</th><th>summary</th></tr></thead><tbody>${rows}</tbody></table>
    48	<p class="mut small" id="fcount"></p>
    49	<script>
    50	(function(){var sel={tool:"",grade:"",safe:"",up:""};var rows=[].slice.call(document.querySelectorAll("#ft tbody tr"));
    51	function apply(){var n=0;rows.forEach(function(r){var ok=Object.keys(sel).every(function(k){return !sel[k]||r.dataset[k]===sel[k]});r.style.display=ok?"":"none";if(ok)n++});document.getElementById("fcount").textContent=n+" of "+rows.length+" findings shown"}
    52	document.getElementById("chips").addEventListener("click",function(e){var b=e.target.closest(".chip");if(!b)return;sel[b.dataset.k]=b.dataset.v;[].forEach.call(document.querySelectorAll('.chip[data-k="'+b.dataset.k+'"]'),function(x){x.classList.toggle("on",x===b)});apply()});apply()})();
    53	</script>`;
    54	  return layout({ title: "fixhunt", active: "home", L, body });
    55	}
    56	
    57	export function findingPage(f: Finding, L: Links): string {
    58	  const { run, report: rep, result: res } = f;
    59	  const ev = rep.evidence;
    60	  const before = rep.minimized;
    61	  const after = ev?.fixed || applyHint(res);
    62	  const v = rep.verdict;
    63	  const dd = rep.dedup;
    64	  const body = `<p class="mut small"><a href="${L.home}">Findings</a> › <a href="${L.run(run.id)}">${esc(ruleLabel(run))}</a> › ${esc(rep.programId)}</p>
    65	<h1>${esc(ruleLabel(run))}: ${esc(kindTitle(rep.kind))}</h1>
    66	<div class="row" style="margin:6px 0 16px">${kindTag(rep.kind)}${rep.safeLabel ? tag("fix labelled safe", "warn") : tag("fix labelled " + run.rule.fixKind)}${gradeTag(f.grade, f.severity)}${f.curated ? statusTag(f.curated.status) : upstreamTag(f.upstream)}<span class="mut small">${esc(toolVersion(run))} · minimized from ${rep.lines.before} to ${rep.lines.after} lines · ${esc(when(run.when))}</span></div>
    67	${f.curated ? `<div class="card"><div class="row">${statusTag(f.curated.status)}<b>${esc(f.curated.title)}</b></div><p class="small" style="margin:6px 0 0">${inline(f.curated.summary)}${f.curated.issue ? ` <a href="${esc(f.curated.issue)}">${esc(issueLabel(f.curated.issue))}</a>` : ""}</p></div>` : ""}
    68	<h2>Same program, before and after the fix</h2>
    69	${sideBySide(before, after)}
    70	<h2>What the oracle observed</h2>
    71	${ev ? outputPair(ev.before, ev.after) : `<pre class="code">${esc(res.findings.find((x) => x.kind === rep.kind)?.detail ?? "")}</pre>`}
    72	<p class="mut small">Both versions run as the same file name under the same interpreter, twice each for determinism, with no network. ${ev ? `The rule fired ${ev.fired} time(s) before the fix and ${ev.firedAfter} after.` : ""}${rep.minimizer ? ` Minimized in ${rep.minimizer.evaluations} oracle evaluations${rep.minimizer.proposal === "accepted" ? ", starting from a Nemotron 3.5 Lightning proposal the oracle accepted" : rep.minimizer.proposal === "rejected" ? "; the Lightning proposal was rejected by the oracle" : ""}.` : ""}</p>
    73	${L.static ? "" : `<p><button class="btn ghost" id="rerun">Re-run this finding now</button> <span class="mut small" id="rerun-out">Lints, fixes and runs the minimized program again, in a fresh Token Factory Sandbox.</span></p>
    74	<div id="rerun-res"></div>
    75	<script>
    76	(function(){var b=document.getElementById("rerun"),o=document.getElementById("rerun-out"),r=document.getElementById("rerun-res");
    77	function esc(s){return String(s==null?"":s).replace(/[&<>]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;"}[c]})}
    78	b.addEventListener("click",function(){b.disabled=true;o.textContent="running…";r.innerHTML="";
    79	fetch("/api/rerun/"+encodeURIComponent(${JSON.stringify(run.id)})+"/"+encodeURIComponent(${JSON.stringify(rep.programId)}),{method:"POST"}).then(function(x){return x.json()}).then(function(j){b.disabled=false;
    80	if(j.error){o.textContent="error: "+j.error;return}
    81	o.textContent=(j.reproduced?"reproduced":"did not reproduce")+" · "+(j.ms/1000).toFixed(1)+" s · "+j.sandbox+" · "+j.version;
    82	var snap=function(s,t){return s?'<div><h3>'+t+' <span class="tag '+(s.code===0&&!s.timedOut?"ok":"bad")+'">'+(s.timedOut?"timed out":"exit "+s.code)+'</span></h3><pre class="code">'+esc((s.stdout||"").trim()||"(no stdout)")+(s.stderr1?"\n"+esc(s.stderr1):"")+'</pre></div>':""};
    83	r.innerHTML='<div class="out">'+snap(j.before,"Output before (fresh run)")+snap(j.after,"Output after (fresh run)")+'</div>';}).catch(function(e){b.disabled=false;o.textContent=String(e)})});})();
    84	</script>`}
    85	${v ? `<h2>Judge</h2><div class="card"><div class="row">${gradeTag(v.grade, v.severity)}<span class="mut small">Nemotron 3 Ultra, with the rule documentation; advisory only</span></div><p style="margin:8px 0 0">${esc(v.why)}</p></div>` : ""}
    86	${ev?.explanation ? `<h2>Why the rewrite is not equivalent</h2><div class="card"><p style="margin:0">${esc(ev.explanation)}</p><p class="mut small" style="margin:8px 0 0">Nemotron 3 Super draft from the diff and the observed outputs. Verify before quoting.</p></div>` : ""}
    87	<h2>Reproduce</h2>
    88	<pre class="code">${esc((ev?.commands ?? []).join("\n") || "(see evidence sheet)")}</pre>
    89	<p class="mut small">Save the "before" program as <code>prog.${esc(run.ext)}</code>. <a href="${L.report(run.id, rep.programId)}">Evidence sheet (Markdown)</a></p>
    90	<h2>Upstream search</h2>
    91	<div class="card">
    92	${dd ? `<p class="small mut" style="margin:0 0 8px">Queries by Nemotron 3 Super, GitHub issue search plus Tavily restricted to the project repo, ${dd.hits.length} hit(s) triaged by Nemotron 3 Ultra.</p>
    93	<p class="small">${dd.queries.map((q) => `<code>${esc(q)}</code>`).join(" · ")}</p>
    94	${dd.verdicts.filter((x) => x.relation !== "unrelated").length ? `<ul class="small" style="margin:6px 0 0;padding-left:18px">${dd.verdicts.filter((x) => x.relation !== "unrelated").map((x) => `<li>${tag(x.relation, x.relation === "duplicate" ? "" : "acc")}<a href="${esc(x.url)}">${esc(issueLabel(x.url))}</a> <span class="mut">${esc(x.why)}</span></li>`).join("")}</ul>` : `<p class="small" style="margin:0">${tag("no duplicate or related report found", "acc")}</p>`}` : `<p class="small mut" style="margin:0">not searched</p>`}
    95	</div>
    96	<h2>Details</h2>
    97	<div class="kv"><b>Program</b><span>${esc(res.title)}</span><b>Hazard</b><span>${esc(res.hazard)}</span><b>Oracle detail</b><span><code class="small">${esc(trunc(ev?.observed ?? "", 400))}</code></span><b>Run</b><span><a href="${L.run(run.id)}">${esc(run.id)}</a></span></div>
    98	<details><summary>Original generated program (${rep.lines.before} lines) and the fix's unified diff</summary>${codeBlock(srcOf(run, res.id))}${res.after?.diff ? unifiedDiff(res.after.diff) : ""}</details>
    99	<details><summary>Rule documentation given to the models</summary><pre class="code" style="white-space:pre-wrap">${esc(run.rule.docs)}</pre></details>`;
   100	  return layout({ title: `${ruleLabel(run)} · fixhunt`, active: "home", L, body });
   101	}
   102	
   103	export function runPage(run: Run, fs: Finding[], L: Links): string {
   104	  const mine = fs.filter((f) => f.run.id === run.id);
   105	  const s = run.summary;
   106	  const rowFor = (r: Run["results"][number]) => {
   107	    const kinds = r.findings.map((x) => x.kind).filter((k) => k !== "disputed");
   108	    const disputed = r.findings.some((x) => x.kind === "disputed");
   109	    const fnd = mine.find((f) => f.report.programId === r.id);
   110	    const status = r.error ? tag("invalid") : kinds.length ? kinds.map((k) => kindTag(k)).join("") : r.before.diagnostics.length ? (r.after?.changed ? tag("fix ok", "ok") : tag("fired, no fix")) : tag("silent");
   111	    return `<tr><td>${fnd ? `<a href="${L.finding(run.id, r.id)}">${esc(r.id)}</a>` : `<a href="#${esc(r.id)}">${esc(r.id)}</a>`}</td><td>${status}${disputed ? tag("prediction off", "warn") : ""}</td><td>${esc(r.title)}</td><td class="mut small">${esc(r.hazard)}</td></tr>`;
   112	  };
   113	  const programs = run.results.map((r) => `<details id="${esc(r.id)}"><summary>${esc(r.id)} — ${esc(r.title)}${r.error ? ` <span class="mut">(${esc(r.error.split("\n")[0].slice(0, 80))})</span>` : ""}</summary>${codeBlock(srcOf(run, r.id))}${r.after?.diff ? unifiedDiff(r.after.diff) : ""}${r.before.run.stdout ? `<pre class="code">${esc(r.before.run.stdout.trimEnd())}</pre>` : ""}</details>`).join("");
   114	  const body = `<p class="mut small"><a href="${L.runs}">Runs</a> › ${esc(run.id)}</p>
   115	<h1>${esc(ruleLabel(run))} <span class="mut" style="font-weight:400;font-size:18px">${esc(toolVersion(run).replace(run.tool + " ", ""))}</span></h1>
   116	<div class="row" style="margin:6px 0 16px">${tag("fix labelled " + run.rule.fixKind, run.rule.fixKind === "safe" ? "warn" : "")}<span class="mut small">${esc(when(run.when))} · ${run.opts?.n ?? "?"} programs × ${run.opts?.rounds ?? "?"} round(s)${run.opts?.unsafe ? " · unsafe fixes applied" : ""} · model cost ${money(run.cost)}</span></div>
   117	<div class="stats">
   118	<div class="stat"><b>${s.programs ?? 0}</b><span>programs evaluated</span></div><div class="stat"><b>${s.fired ?? 0}</b><span>rule fired</span></div><div class="stat"><b>${s.fixed ?? 0}</b><span>fix applied</span></div><div class="stat"><b>${mine.length}</b><span>oracle-backed findings</span></div><div class="stat"><b>${s.invalid ?? 0}</b><span>rejected programs</span></div>
   119	</div>
   120	${run.analysis ? `<div class="card"><h3 style="margin-top:0">Rule analysis <span class="mut" style="text-transform:none;letter-spacing:0;font-weight:400">· Nemotron 3 Super</span></h3><p style="margin:0 0 6px">${esc(run.analysis.summary)}</p><p class="mut small" style="margin:0">Fix: ${esc(run.analysis.fixDescription)}</p><details><summary>${(run.analysis.hazards ?? []).length} rule-specific hazards the generator was pointed at</summary><ul class="small">${(run.analysis.hazards ?? []).map((h: string) => `<li>${esc(h)}</li>`).join("")}</ul></details></div>` : ""}
   121	${mine.length ? `<h2>Findings</h2><table class="tbl"><thead><tr><th>program</th><th>oracle</th><th>label</th><th>judge</th><th>status</th><th>summary</th></tr></thead><tbody>${mine.map((f) => `<tr><td><a href="${L.finding(run.id, f.report.programId)}">${esc(f.report.programId)}</a></td><td>${kindTag(f.report.kind)}</td><td>${f.report.safeLabel ? tag("safe", "warn") : tag("unsafe")}</td><td>${gradeTag(f.grade, f.severity)}</td><td>${f.curated ? statusTag(f.curated.status) : upstreamTag(f.upstream)}</td><td class="mut small">${esc(trunc(f.report.verdict?.why ?? "", 160))}</td></tr>`).join("")}</tbody></table>` : ""}
   122	<h2>All programs</h2>
   123	<table class="tbl"><thead><tr><th>id</th><th>result</th><th>title</th><th>hazard</th></tr></thead><tbody>${run.results.map(rowFor).join("")}</tbody></table>
   124	<h2>Sources</h2>${programs}`;
   125	  return layout({ title: `${ruleLabel(run)} run · fixhunt`, active: "runs", L, body });
   126	}
   127	
   128	export function runsPage(runs: Run[], fs: Finding[], L: Links): string {
   129	  const rows = runs.map((r) => {
   130	    const mine = fs.filter((f) => f.run.id === r.id);
   131	    const real = mine.filter((f) => f.grade === "real" || f.grade === "unclear" || f.grade === "unjudged").length;
   132	    return `<tr data-tool="${esc(r.tool)}" data-has="${mine.length ? 1 : 0}"><td><a href="${L.run(r.id)}">${esc(r.rule.rule)}</a></td><td>${esc(toolVersion(r))}</td><td class="num">${r.summary.programs ?? 0}</td><td class="num">${r.summary.fired ?? 0}</td><td class="num">${r.summary.fixed ?? 0}</td><td>${mine.length ? `<span class="tag ${real ? "bad" : ""}">${real} / ${mine.length}</span>` : `<span class="mut">0</span>`}</td><td class="num">${money(r.cost)}</td><td class="mut small">${esc(when(r.when))}</td></tr>`;
   133	  }).join("");
   134	  const tools = [...new Set(runs.map((r) => r.tool))];
   135	  const body = `<h1>Runs</h1><p class="lead">One run is one rule of one tool at one version: analysis, generated programs, oracles, then minimization, judging and upstream search for every hit.</p>
   136	<div class="chips" id="chips"><button class="chip on" data-k="tool" data-v="">all tools</button>${tools.map((t) => `<button class="chip" data-k="tool" data-v="${esc(t)}">${esc(t)}</button>`).join("")}<span style="width:10px"></span><button class="chip on" data-k="has" data-v="">all runs</button><button class="chip" data-k="has" data-v="1">with findings</button></div>
   137	<table class="tbl" id="rt"><thead><tr><th>rule</th><th>tool</th><th>programs</th><th>fired</th><th>fixed</th><th>findings (real-graded / all)</th><th>cost</th><th>when</th></tr></thead><tbody>${rows}</tbody></table>
   138	<p class="mut small" id="fcount"></p>
   139	<script>
   140	(function(){var sel={tool:"",has:""};var rows=[].slice.call(document.querySelectorAll("#rt tbody tr"));
   141	function apply(){var n=0;rows.forEach(function(r){var ok=Object.keys(sel).every(function(k){return !sel[k]||r.dataset[k]===sel[k]});r.style.display=ok?"":"none";if(ok)n++});document.getElementById("fcount").textContent=n+" of "+rows.length+" runs shown"}
   142	document.getElementById("chips").addEventListener("click",function(e){var b=e.target.closest(".chip");if(!b)return;sel[b.dataset.k]=b.dataset.v;[].forEach.call(document.querySelectorAll('.chip[data-k="'+b.dataset.k+'"]'),function(x){x.classList.toggle("on",x===b)});apply()});apply()})();
   143	</script>`;
   144	  return layout({ title: "Runs · fixhunt", active: "runs", L, body });
   145	}
   146	
   147	export function huntPage(catalog: Record<string, Array<{ rule: string; fixKind: string }>>, L: Links, busy?: string, toolIds: string[] = Object.keys(catalog)): string {
   148	  const opts = Object.entries(catalog).map(([t, rs]) => rs.map((r) => `<option value="${esc(r.rule)}" data-tool="${esc(t)}">${esc(t)}: ${esc(r.rule)} (${esc(r.fixKind)})</option>`).join("")).join("");
   149	  const toolOpts = toolIds.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join("");
   150	  const body = `<h1>Live hunt</h1>
   151	<p class="lead">Pick a tool and a rule. Nemotron 3 Super reads the rule documentation, lists the semantic hazards and writes programs on those edges. Each program is linted, fixed with the tool's own fix, and run before and after. Hits are minimized, judged by Nemotron 3 Ultra and searched upstream. A small hunt costs a few cents and takes two to five minutes.</p>
   152	${L.static ? `<div class="card">The live hunt needs the fixhunt server (<code>bun src/cli.ts serve</code>). This is a static export.</div>` : `
   153	<div class="card"><form id="hf" class="row" style="gap:14px;align-items:flex-end">
   154	<label class="f">tool<select name="tool" id="tool">${toolOpts}</select></label>
   155	<label class="f">rule<input name="rule" id="rule" list="rules" placeholder="rule id as the tool names it" size="46" required><datalist id="rules">${opts}</datalist></label>
   156	<label class="f">programs<input name="n" type="number" min="2" max="10" value="6" style="width:70px"></label>
   157	<label class="f">rounds<input name="rounds" type="number" min="1" max="2" value="1" style="width:60px"></label>
   158	<label class="f"><span>&nbsp;</span><span class="row" style="gap:6px"><input type="checkbox" name="unsafe" id="unsafe"> <label for="unsafe" class="small">also apply unsafe fixes</label></span></label>
   159	<button class="btn" id="go" type="submit">Start hunt</button>
   160	</form>${busy ? `<p class="mut small" style="margin:10px 0 0">A hunt is already running: <a href="#" id="attach" data-id="${esc(busy)}">watch it</a>.</p>` : ""}</div>
   161	<div id="status" class="mut small"></div>
   162	<div id="head"></div>
   163	<div id="feed" class="feed"></div>
   164	<div id="post"></div>
   165	<div id="log" class="log"></div>
   166	<script>
   167	(function(){
   168	var $=function(s){return document.querySelector(s)};var feed=$("#feed"),head=$("#head"),post=$("#post"),log=$("#log"),status=$("#status");
   169	function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
   170	function tag(t,c){return '<span class="tag '+(c||"")+'">'+esc(t)+'</span>'}
   171	var cards={};
   172	function onEvent(e){
   173	  if(e.type==="start"){head.innerHTML='<div class="card"><b>'+esc(e.tool)+' '+esc(e.version)+' · '+esc(e.rule)+'</b> '+tag("fix labelled "+e.fixKind,e.fixKind==="safe"?"warn":"")+'<div class="mut small">run '+esc(e.runId)+' · sandbox: '+esc(e.sandbox)+'</div><div id="an" class="small mut" style="margin-top:6px">Nemotron 3 Super is reading the rule documentation…</div></div>';status.textContent="running";}
   174	  else if(e.type==="analysis"){$("#an").innerHTML='<div><b style="color:var(--fg)">Analysis</b> · $'+e.cost.toFixed(4)+'</div><div>'+esc(e.summary)+'</div><div>Fix: '+esc(e.fixDescription)+'</div><details><summary>'+e.hazards.length+' hazards</summary><ul>'+e.hazards.map(function(h){return '<li>'+esc(h)+'</li>'}).join("")+'</ul></details><div id="rounds"></div>';}
   175	  else if(e.type==="round"){$("#rounds").insertAdjacentHTML("beforeend",'<div>Round '+e.round+': '+e.programs+' programs written · $'+e.cost.toFixed(4)+'</div>');}
   176	  else if(e.type==="round-failed"){$("#rounds").insertAdjacentHTML("beforeend",'<div style="color:var(--bad)">Round '+e.round+' failed: '+esc(e.error)+'</div>');}
   177	  else if(e.type==="program"){var cls=e.status==="finding"?"finding":e.status==="fix-ok"?"fix-ok":"";var st=e.status==="finding"?e.kinds.filter(function(k){return k!=="disputed"}).map(function(k){return tag(k,"bad")}).join(""):e.status==="fix-ok"?tag("fix ok","ok"):e.status==="silent"?tag("silent"):e.status==="fired-no-fix"?tag("fired, no fix"):tag(e.status,"warn");
   178	    var d=document.createElement("div");d.className="card "+cls;d.id="p-"+e.id;d.innerHTML='<div class="t">'+esc(e.id)+' · '+esc(e.title)+'</div><div>'+st+'</div><div class="mut" style="margin-top:4px">'+esc(e.detail.length>160?e.detail.slice(0,160)+"…":e.detail)+'</div>'+(e.code?'<details><summary>program</summary><pre class="code">'+esc(e.code)+'</pre>'+(e.diff?'<pre class="code">'+esc(e.diff)+'</pre>':'')+'</details>':'');feed.appendChild(d);cards[e.id]=d;}
   179	  else if(e.type==="log"){log.textContent+=e.message+"\\n";}
   180	  else if(e.type==="report"){var c=cards[e.programId];if(c){c.insertAdjacentHTML("beforeend",'<div style="margin-top:6px">minimized to '+e.lines.after+' lines · judge: '+(e.grade?tag(e.grade+" · "+e.severity,e.grade==="real"?"bad":""):"n/a")+' · '+(e.duplicates.length?e.duplicates.map(function(x){return tag(x.relation)+'<a href="'+esc(x.url)+'">'+esc(x.url.replace("https://github.com/",""))+'</a>'}).join(" "):tag("no upstream match","acc"))+'</div>');}}
   181	  else if(e.type==="done"){status.innerHTML='done · '+e.findings+' oracle-backed finding(s) · model cost $'+e.cost.toFixed(4)+' · <a href="/r/'+encodeURIComponent(e.runId)+'">open the run</a>';$("#go").disabled=false;}
   182	  else if(e.type==="error"){status.innerHTML='<span style="color:var(--bad)">'+esc(e.message)+'</span>';$("#go").disabled=false;}
   183	}
   184	function watch(id){var es=new EventSource("/api/hunt/"+encodeURIComponent(id)+"/events");es.onmessage=function(m){var e=JSON.parse(m.data);onEvent(e);if(e.type==="done"||e.type==="error")es.close()};es.onerror=function(){status.textContent="connection lost; reload to re-attach"}}
   185	$("#hf").addEventListener("submit",function(ev){ev.preventDefault();var f=new FormData(ev.target);var body={tool:f.get("tool"),rule:f.get("rule"),n:Number(f.get("n")),rounds:Number(f.get("rounds")),unsafe:!!f.get("unsafe")};feed.innerHTML="";head.innerHTML="";post.innerHTML="";log.textContent="";cards={};$("#go").disabled=true;status.textContent="starting…";
   186	  fetch("/api/hunt",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)}).then(function(r){return r.json()}).then(function(j){if(j.error){status.innerHTML='<span style="color:var(--bad)">'+esc(j.error)+'</span>';$("#go").disabled=false;return}watch(j.id)}).catch(function(e){status.textContent=String(e);$("#go").disabled=false})});
   187	var at=$("#attach");if(at)at.addEventListener("click",function(ev){ev.preventDefault();$("#go").disabled=true;watch(at.dataset.id)});
   188	$("#tool").addEventListener("change",function(){$("#rule").value=""});
   189	})();
   190	</script>`}`;
   191	  return layout({ title: "Live hunt · fixhunt", active: "hunt", L, body });
   192	}
   193	
   194	export function aboutPage(st: Stats, sp: Spend, L: Links): string {
   195	  const stage = (name: string, text: string, model?: string) => `<div class="st"><b>${esc(name)}</b>${esc(text)}${model ? `<em>${esc(model)}</em>` : "<em>no model</em>"}</div>`;
   196	  const models = Object.entries(sp.byModel).sort((a, b) => b[1].cost - a[1].cost);
   197	  const tags = Object.entries(sp.byTag).sort((a, b) => b[1].cost - a[1].cost);
   198	  const body = `<h1>How it works</h1>
   199	<p class="lead">Every linter labels some automatic fixes "safe", and CI pipelines apply those without review. A safe fix must preserve program behavior. fixhunt tests that claim directly instead of trusting a model's opinion about it.</p>
   200	<h2>Pipeline</h2>
   201	<div class="pipe">
   202	${stage("1 analyze", "Read the rule docs, list firing shapes and rule-specific semantic hazards.", "Nemotron 3 Super")}
   203	${stage("2 generate", "Write N small deterministic programs, one per hazard, with a prediction of whether the rule fires.", "Nemotron 3 Super")}
   204	${stage("3 run", "Lint and apply the fix locally with the pinned tool version; run the program before and after, twice each, in a fresh Token Factory Sandbox VM without network.", "Token Factory Sandboxes")}
   205	${stage("4 oracles", "Crash, parse failure, output or exit-code difference, fixpoint violation, safe-label mismatch.")}
   206	${stage("5 minimize", "Delta debugging over lines with the oracle as the test and the before-run shape as invariant.")}
   207	${stage("6 judge", "Grade each hit with the rule docs: real, intended-change, introspection-only, program-bug.", "Nemotron 3 Ultra")}
   208	${stage("7 dedup", "Search queries, GitHub issue search plus Tavily on the project repo, strict duplicate triage.", "Super + Ultra, Tavily")}
   209	${stage("8 report", "Evidence sheet with repro, commands, outputs, diff and a one-paragraph explanation. Nothing is posted.", "Nemotron 3 Super")}
   210	</div>
   211	<h2>Oracles</h2>
   212	<table class="tbl"><thead><tr><th>oracle</th><th>finding kind</th><th>what it checks</th></tr></thead><tbody>
   213	<tr><td>O1</td><td>${kindTag("tool-crash")}</td><td>The linter or the fixer panics or exits abnormally.</td></tr>
   214	<tr><td>O2</td><td>${kindTag("fix-breaks-syntax")}</td><td>The fixed file no longer parses or compiles, per the tool spec's check command.</td></tr>
   215	<tr><td>O3</td><td>${kindTag("fix-changes-behavior")}</td><td>stdout, exit code or first error line differ between the two runs of the same file name.</td></tr>
   216	<tr><td>O4</td><td>${kindTag("fix-not-fixpoint")}</td><td>The rule still fires, or fires more, after its own fix.</td></tr>
   217	<tr><td>O5</td><td>${tag("fix labelled safe", "warn")}</td><td>The tool labels the fix safe (per diagnostic or per rule, whichever the tool reports) and O2 or O3 failed. The headline class.</td></tr>
   218	</tbody></table>
   219	<h2>Trust rules</h2>
   220	<ul>
   221	<li>A finding is never a model's opinion. The model proposes programs; the oracles decide.</li>
   222	<li>Both versions of a program run under the same file name, so stack traces and <code>__file__</code> cannot differ by path.</li>
   223	<li>Generated programs never run on the host. Each run is a disposable Token Factory Sandbox with networking off; the working directory is shipped as a tarball on stdin. Minimization runs under bubblewrap locally (dozens of evaluations per finding) and the minimized program is then confirmed in a sandbox.</li>
   224	<li>Non-deterministic or non-terminating programs are rejected before the fix is applied.</li>
   225	<li>The judge sees the rule documentation and must separate documented rewrites from bugs. It is advisory and shown as such.</li>
   226	<li>Only GitHub issue and pull-request URLs count as upstream matches; docs pages and changelogs do not.</li>
   227	<li>Nothing is posted anywhere. Issues are filed by a person, after re-verification, in their own words, respecting each project's AI-contribution policy.</li>
   228	</ul>
   229	<h2>Models and spend</h2>
   230	<p class="small mut">All inference runs on Nebius Token Factory; generated programs run in Token Factory Sandboxes (${st.sandboxRuns} runs so far, ${money(st.sandboxCost)}). Routing: ${Object.entries(MODELS).map(([k, v]) => `${k} → <code>${esc(v)}</code>`).join(", ")}.</p>
   231	<table class="tbl"><thead><tr><th>model</th><th>calls</th><th>prompt tokens</th><th>completion tokens</th><th>cost</th></tr></thead><tbody>${models.map(([m, v]) => `<tr><td><code>${esc(m)}</code></td><td class="num">${v.calls}</td><td class="num">${v.prompt.toLocaleString()}</td><td class="num">${v.completion.toLocaleString()}</td><td class="num">${money(v.cost)}</td></tr>`).join("")}<tr><td><b>total</b></td><td></td><td></td><td></td><td class="num"><b>${money(sp.total)}</b></td></tr></tbody></table>
   232	<table class="tbl" style="margin-top:12px"><thead><tr><th>stage</th><th>calls</th><th>cost</th></tr></thead><tbody>${tags.map(([t, v]) => `<tr><td>${esc(t)}</td><td class="num">${v.calls}</td><td class="num">${money(v.cost)}</td></tr>`).join("")}</tbody></table>
   233	<h2>Lessons so far</h2>
   234	<ul>
   235	<li>Nemotron 3.5 Lightning truncates to one array item under json_schema output and ignores length constraints; Super follows the brief, so Super writes the programs and Lightning is kept for cheap classification.</li>
   236	<li>Without the rule documentation the judge graded nearly every behavior difference "real"; with it, documented rewrites (F632 <code>is</code> → <code>==</code>, G010 <code>warn</code> → <code>warning</code>) separate from bugs, though it still over-grades.</li>
   237	<li>Delta debugging needs an invariant beyond "the oracle still fires", or it reduces a clean repro to a program that merely crashes earlier.</li>
   238	<li>Token Factory occasionally returns an <code>[ERROR: …]</code> body with status 200; treated as a transient failure and retried.</li>
   239	</ul>
   240	<p class="mut small">Tool versions under test: ${Object.entries(st.versions).map(([t, v]) => `${esc(t)} ${esc(v)}`).join(", ")}.</p>`;
   241	  return layout({ title: "How it works · fixhunt", active: "about", L, body });
   242	}
   243	
   244	export function scansPage(scans: Scan[], L: Links): string {
   245	  const rows = scans.map((s) => `<tr><td><a href="${L.scan(s.id)}">${esc(s.project.split("/").pop() ?? s.project)}</a><div class="mut small">${esc(s.run)}</div></td><td>${esc(s.tool)} ${esc(s.version.replace(s.tool + " ", ""))}</td><td class="num">${s.rules}</td><td class="num">${s.applied}</td><td>${s.findings.length ? `<span class="tag bad">${s.findings.length}</span>` : `<span class="mut">0</span>`}</td><td class="mut small">${esc(when(s.when))}</td></tr>`).join("");
   246	  const body = `<h1>Repository scans</h1><p class="lead">Scan mode applies every safe fix of a tool to a copy of a real project, one rule at a time, and runs the project's own command before and after in a fresh Token Factory Sandbox. A finding is a rule whose fix changed the command's output or exit status.</p>
   247	<pre class="code">bun src/cli.ts scan --tool ruff --dir ~/myproject --run "pip install -q pytest && pytest -q"</pre>
   248	${scans.length ? `<table class="tbl"><thead><tr><th>project · command</th><th>tool</th><th>rules tried</th><th>rules that changed files</th><th>changed outcome</th><th>when</th></tr></thead><tbody>${rows}</tbody></table>` : `<p class="mut">No scans yet.</p>`}`;
   249	  return layout({ title: "Scans · fixhunt", active: "scans", L, body });
   250	}
   251	
   252	export function scanPage(s: Scan, details: Array<{ rule: string; finding: any }>, L: Links): string {
   253	  const cards = details.map(({ rule, finding: f }) => `<div class="card" id="${esc(rule)}"><div class="row"><b>${esc(rule)}</b>${kindTag(f.kind)}<span class="mut small">exit ${f.before.code} → ${f.after.code}${f.after.timedOut ? " (timed out)" : ""} · ${f.changedFiles.length} file(s): ${esc(f.changedFiles.slice(0, 6).join(", "))}${f.changedFiles.length > 6 ? "…" : ""}</span></div>
   254	<div class="out" style="margin-top:8px"><div><h3>Command output before</h3><pre class="code">${esc(f.before.stdout.trim().slice(-3000) || "(no output)")}</pre></div><div><h3>Command output after</h3><pre class="code">${esc((f.after.stdout.trim() || f.after.stderr.trim()).slice(-3000) || "(no output)")}</pre></div></div>
   255	<details><summary>Diff applied by the fix (${f.diff.split("\n").length} lines)</summary>${unifiedDiff(f.diff.slice(0, 20000))}</details></div>`).join("");
   256	  const body = `<p class="mut small"><a href="${L.scans}">Scans</a> › ${esc(s.id)}</p>
   257	<h1>${esc(s.project.split("/").pop() ?? s.project)} <span class="mut" style="font-weight:400;font-size:18px">${esc(s.tool)} ${esc(s.version.replace(s.tool + " ", ""))}</span></h1>
   258	<p class="mut small">${esc(s.project)} · command <code>${esc(s.run)}</code> · ${esc(when(s.when))}</p>
   259	<div class="stats"><div class="stat"><b>${s.rules}</b><span>rules tried</span></div><div class="stat"><b>${s.applied}</b><span>fixes that changed files</span></div><div class="stat"><b>${s.findings.length}</b><span>changed the command's outcome</span></div></div>
   260	${details.length ? cards : `<div class="card">Every fix that changed files left the command's output and exit status unchanged.</div>`}`;
   261	  return layout({ title: `scan ${s.project.split("/").pop()} · fixhunt`, active: "scans", L, body });
   262	}
   263	
   264	// helpers
   265	function trunc(s: string, n: number) { return s.length > n ? s.slice(0, n - 1) + "…" : s; }
   266	function inline(s: string) { return esc(s).replace(/`([^`]+)`/g, "<code>$1</code>"); }
   267	function srcOf(run: Run, id: string): string {
   268	  try { return require("node:fs").readFileSync(`${run.dir}/${id}/orig.${run.ext}`, "utf8"); } catch { return "(source missing)"; }
   269	}
   270	/** Fallback when evidence is missing: show the unified diff target only. */
   271	function applyHint(res: Run["results"][number]): string { return res.after?.diff ? "(fixed source not recorded; see the unified diff below)" : "(no fix applied)"; }

