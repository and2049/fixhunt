    93	/** Run `fn` over `items` with at most `limit` in flight; results keep input order. */
    94	async function mapLimit<T, R>(items: T[], limit: number, fn: (t: T) => Promise<R>): Promise<R[]> {
    95	  const out: R[] = new Array(items.length);
    96	  let next = 0;
    97	  const worker = async () => { for (;;) { const i = next++; if (i >= items.length) return; out[i] = await fn(items[i]); } };
    98	  await Promise.all(Array.from({ length: Math.max(1, Math.min(limit, items.length)) }, worker));
    99	  return out;
   100	}
