    19	const PRICES: Record<string, [number, number]> = {
    20	  // $ per 1M tokens, input / output; verify against the Token Factory console
    21	  "nvidia/Nemotron-3_5-Lightning": [0.06, 0.24],
    22	  "nvidia/nemotron-3-super-120b-a12b": [0.3, 0.9],
    23	  "nvidia/Nemotron-3-Ultra-550b-a55b": [1, 3],
