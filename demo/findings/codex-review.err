   133	  } else if (l2.diagnostics.length >= l1.diagnostics.length) {
   134	    res.findings.push({ kind: "fix-not-fixpoint", safeLabel, detail: `${l1.diagnostics.length} diagnostics before, ${l2.diagnostics.length} after the fix` });
   135	  }
   136	  return res;
   137	}
   138	
   139	function describeDiff(a: Snap, b: Snap): string {
   140	  const parts: string[] = [];
   141	  if (a.stdout !== b.stdout) parts.push(`stdout before:\n${a.stdout.trimEnd()}\nstdout after:\n${b.stdout.trimEnd()}`);
   142	  if (a.code !== b.code || a.timedOut !== b.timedOut) parts.push(`exit ${a.timedOut ? "timeout" : a.code} → ${b.timedOut ? "timeout" : b.code}`);
   143	  if (a.stderr1 !== b.stderr1) parts.push(`stderr before: ${a.stderr1 || "(none)"}\nstderr after: ${b.stderr1 || "(none)"}`);
   144	  return parts.join("\n");
   145	}

