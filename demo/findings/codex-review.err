    32	  const id = Math.random().toString(36).slice(2, 10);
    33	  const live: Live = { id, events: [], listeners: new Set(), done: false, started: Date.now() };
    34	  hunts.set(id, live);
    35	  running = live;
    36	  const emit = (e: HuntEvent) => { live.events.push(e); for (const l of live.listeners) l(e); if (e.type === "done" || e.type === "error") live.done = true; };
    37	  hunt({ tool, rule: body.rule, n: Math.max(2, Math.min(MAX_N, body.n || 6)), rounds: Math.max(1, Math.min(MAX_ROUNDS, body.rounds || 1)), unsafe: !!body.unsafe, onEvent: emit })
