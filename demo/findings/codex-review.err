    42	    // Both forms are accepted by Token Factory for Nemotron; keep both for safety.
    43	    body.chat_template_kwargs = { enable_thinking: false };
    44	    body.reasoning_effort = "none";
    45	  }
    46	  if (opts.schema) {
    47	    body.response_format = { type: "json_schema", json_schema: { name: opts.schema.name, schema: opts.schema.schema } };
    48	  }
    49	
    50	  let lastErr: unknown;
    51	  for (let attempt = 0; attempt < 4; attempt++) {
    52	    try {
    53	      const res = await fetch(`${LLM.baseUrl}chat/completions`, {
    54	        method: "POST",
    55	        headers: { "content-type": "application/json", authorization: `Bearer ${LLM.apiKey}` },
    56	        body: JSON.stringify(body),
    57	        signal: AbortSignal.timeout(180_000),
