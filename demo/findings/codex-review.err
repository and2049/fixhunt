    46	      gen = await generatePrograms(info, an.analysis, { n: o.n, language: o.tool.language, runner: o.tool.runnerHint ?? "", seed: (o.seed ?? 1) * 7919 + round, feedback, model: o.model });
    47	    } catch (e) {
    48	      emit({ type: "round-failed", round: round + 1, error: String(e).split("\n")[0].slice(0, 160) });
