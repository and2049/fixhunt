    12	async function detectBwrap(): Promise<boolean> {
    13	  if (bwrapOk !== null) return bwrapOk;
    14	  try {
    15	    const p = Bun.spawn(["bwrap", "--unshare-net", "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "true"], {
    16	      stdout: "ignore",
    17	      stderr: "ignore",
    18	    });
    19	    bwrapOk = (await p.exited) === 0;
    20	  } catch {
    21	    bwrapOk = false;
    22	  }
    23	  return bwrapOk;
    24	}
    25	
    26	const MODE = (process.env.FIXHUNT_SANDBOX ?? "auto").toLowerCase();
    27	
    28	let localOnly = 0;
    29	/** Run `fn` with generated-program execution forced local (bwrap). Used by minimization, which needs
    30	 * dozens of evaluations per finding; the minimized result is then confirmed in a real sandbox. */
    31	export async function withLocalSandbox<T>(fn: () => Promise<T>): Promise<T> {
    32	  localOnly++;
    33	  try { return await fn(); } finally { localOnly--; }
    34	}
    35	
    36	export async function useContree(): Promise<boolean> {
    37	  if (MODE === "bwrap" || MODE === "none" || (localOnly > 0 && MODE !== "contree-always")) return false;
    38	  const s = await contreeStatus();
    39	  if (!s.ok && MODE === "contree") throw new Error(`FIXHUNT_SANDBOX=contree but sandboxes are unavailable: ${s.why}`);
    40	  return s.ok;
    41	}
    42	
    43	export async function sandboxInfo(net = false): Promise<string> {
    44	  if (await useContree()) return `Token Factory Sandboxes (fresh VM per run, ${net ? "network on" : "no network"})`;
    45	  const s = await contreeStatus();
    46	  const why = MODE === "auto" && s.why ? ` (sandboxes unavailable: ${s.why})` : "";
    47	  return (await detectBwrap()) ? `bwrap (no network, read-only root)${why}` : `plain process (no isolation beyond timeout)${why}`;
    48	}
    49	
    50	export async function exec(cmd: string[], opts: { cwd: string; timeoutMs?: number; isolate?: boolean; image?: string; env?: Record<string, string>; maxOutput?: number; net?: boolean; recursive?: boolean; exclude?: string[] }): Promise<ExecResult> {
    51	  const timeoutMs = opts.timeoutMs ?? 5000;
    52	  const cwd = resolve(opts.cwd);
    53	  if (opts.isolate && opts.image && (await useContree())) {
    54	    try {
    55	      const r = await runInSandbox(cmd, { image: opts.image, cwd, env: opts.env, timeoutMs, maxOutput: opts.maxOutput, net: opts.net, recursive: opts.recursive, exclude: opts.exclude });
    56	      return { stdout: cap(r.stdout, opts.maxOutput), stderr: cap(r.stderr, opts.maxOutput), code: r.code, timedOut: r.timedOut, signal: r.signal };
    57	    } catch (e) {
    58	      return { stdout: "", stderr: `sandbox failure: ${String((e as Error).message ?? e)}`, code: null, timedOut: false };
    59	    }
    60	  }
    61	  let argv = cmd;
    62	  if (opts.isolate && (await detectBwrap())) {
    63	    argv = [
    64	      "bwrap", ...(opts.net ? [] : ["--unshare-net"]), "--unshare-pid", "--die-with-parent",
    65	      "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp",
    66	      "--bind", cwd, cwd, "--chdir", cwd,
    67	      ...cmd,
    68	    ];
    69	  }
    70	  const p = Bun.spawn(argv, { cwd, stdout: "pipe", stderr: "pipe", env: { ...process.env, ...opts.env } });
    71	  let timedOut = false;
    72	  const timer = setTimeout(() => {
    73	    timedOut = true;
    74	    try { p.kill("SIGKILL"); } catch {}
