    91	export async function chatJson<T>(opts: ChatOpts): Promise<{ value: T; usage: Usage; cost: number }> {
    92	  let usage: Usage = { prompt: 0, completion: 0, reasoning: 0 };
    93	  let cost = 0;
    94	  let last = "";
    95	  for (let attempt = 0; attempt < 3; attempt++) {
    96	    const r = await chat(attempt === 0 ? opts : { ...opts, temperature: Math.min(1, (opts.temperature ?? 0.7) + 0.1 * attempt) });
    97	    usage = { prompt: usage.prompt + r.usage.prompt, completion: usage.completion + r.usage.completion, reasoning: usage.reasoning + r.usage.reasoning };
    98	    cost += r.cost;
    99	    const value = parseJsonLoose<T>(r.text);
   100	    if (value !== undefined) return { value, usage, cost };
   101	    last = r.text;
   102	  }
   103	  throw new Error(`model did not return JSON (${opts.tag}) after 3 attempts: ${last.slice(0, 300)}`);
   104	}
