    72	  for (;;) {
    73	    const r = await fetch(`${BASE}/operations/${opId}`, { headers: headers(), signal: AbortSignal.timeout(30_000) });
    74	    if (!r.ok) { if (r.status >= 500 || r.status === 429) { await Bun.sleep(1000); continue; } throw new Error(`sandbox status failed: ${r.status}`); }
    75	    const j: any = await r.json();
    76	    if (j.status === "SUCCESS" || j.status === "FAILED" || j.status === "CANCELLED") {
    77	      const res = j.metadata?.result;
    78	      if (!res) throw new Error(`sandbox operation ${j.status}: ${j.error ?? "no result"}`);
    79	      const dec = (x: any) => (x?.encoding === "base64" ? Buffer.from(x.value ?? "", "base64").toString("utf8") : String(x?.value ?? ""));
