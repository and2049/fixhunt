    32	/** Model-free: fill in `evidence` for reports that predate it, by evaluating the minimized program once. */
    33	export async function refreshEvidence(tools: Record<string, Tool>, opts: { only?: string; force?: boolean }) {
    34	  let n = 0;
    35	  for (const d of runDirs(opts.only)) {
    36	    const dir = join(RUNS_DIR, d);
    37	    const run = JSON.parse(readFileSync(join(dir, "results.json"), "utf8"));
    38	    const tool = tools[run.tool];
    39	    if (!tool || !run.reports?.length) continue;
    40	    let changed = false;
    41	    for (const rep of run.reports) {
    42	      if (rep.evidence && !opts.force) continue;
    43	      const unsafe = run.opts?.unsafe ?? false;
    44	      const r = await evaluateProgram(tool, run.rule, join(dir, rep.programId, "min"), { id: `${rep.programId}-ev`, title: "min", hazard: "", code: rep.minimized, expectTrigger: true }, { unsafe });
    45	      const f = r.findings.find((x) => x.kind === rep.kind);
    46	      const md = existsSync(rep.reportPath) ? readFileSync(rep.reportPath, "utf8") : "";
    47	      const ex = /## Why the rewrite is not equivalent[^\n]*\n\n([\s\S]*?)\n\n## /.exec(md)?.[1]?.trim();
    48	      rep.evidence = evidenceOf(tool, run.rule, join(dir, rep.programId, "min", r.id), r, f?.detail ?? r.error ?? "(finding did not reproduce)", ex, unsafe);
    49	      if (!f) {
    50	        // Stale: an oracle change (e.g. better output normalization) removed the finding. Drop it from the run.
    51	        console.log(`  ${d} ${rep.programId}: finding ${rep.kind} did not reproduce on refresh; dropped`);
    52	        run.reports = run.reports.filter((x: any) => x !== rep);
    53	        const res = run.results.find((x: any) => x.id === rep.programId);
    54	        if (res) res.findings = res.findings.filter((x: any) => x.kind !== rep.kind);
    55	      }
    56	      changed = true; n++;
    57	    }
    58	    if (changed) writeFileSync(join(dir, "results.json"), JSON.stringify(run, null, 2));
    59	  }
    60	  console.log(`refreshed evidence for ${n} finding(s)`);
    61	}
     1	// Rule catalogs: which rules exist, whether they have a fix and how the tool labels it. Built from the tool
     2	// spec's catalog command and cached in data/<tool>-rules.json.
     3	import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
     4	import type { SpecTool } from "./tools/spec";
     5	
     6	export type CatalogRule = { rule: string; fixKind: "safe" | "unsafe" | "none" | "unknown"; languages?: string[]; name?: string; note?: string };
     7	
     8	export const catalogPath = (toolId: string) => `data/${toolId}-rules.json`;
     9	
    10	export async function catalogFor(tool: SpecTool, refresh = false): Promise<CatalogRule[]> {
    11	  const out = catalogPath(tool.id);
    12	  if (!refresh && existsSync(out)) return JSON.parse(readFileSync(out, "utf8"));
    13	  const rules = await tool.catalog();
    14	  mkdirSync("data", { recursive: true });
    15	  writeFileSync(out, JSON.stringify(rules, null, 1));
    16	  return rules;
    17	}
    18	
    19	/** Rules a sweep should hunt, per the spec's sweep section. */
    20	export function sweepRules(tool: SpecTool, catalog: CatalogRule[], unsafe: boolean): CatalogRule[] {
    21	  const sw = tool.spec.sweep ?? {};
    22	  const kinds = unsafe ? sw.unsafeFixKinds ?? ["safe", "unsafe", "unknown"] : sw.fixKinds ?? ["safe"];
    23	  let rules = catalog.filter((r) => kinds.includes(r.fixKind));
    24	  if (sw.languages?.length) rules = rules.filter((r) => !r.languages?.length || r.languages.some((l) => sw.languages!.includes(l)));
    25	  if (sw.requireNoteRegex && !unsafe) rules = rules.filter((r) => new RegExp(sw.requireNoteRegex!, "i").test(r.note ?? ""));
    26	  if (sw.skipRuleRegex) rules = rules.filter((r) => !new RegExp(sw.skipRuleRegex!).test(r.rule));
    27	  return rules;
    28	}
     1	// Sweep: hunt every rule the tool spec's sweep section selects (by default, every rule with a fix labelled safe).
     2	import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
     3	import { join } from "node:path";
     4	import { catalogFor, sweepRules, type CatalogRule } from "./catalog";
     5	import { RUNS_DIR } from "./config";
     6	import { hunt } from "./hunt";
     7	import type { SpecTool } from "./tools/spec";
     8	
     9	export type SweepOpts = { tool: SpecTool; n: number; rounds: number; unsafe: boolean; limit?: number; only?: RegExp; resume?: boolean };
    10	
    11	export async function sweep(o: SweepOpts) {
    12	  const catalog = await catalogFor(o.tool);
    13	  let rules: CatalogRule[] = sweepRules(o.tool, catalog, o.unsafe);
    14	  if (o.only) rules = rules.filter((r) => o.only!.test(r.rule));
    15	  if (o.limit) rules = rules.slice(0, o.limit);
    16	  const stateFile = join(RUNS_DIR, `sweep-${o.tool.id}.json`);
    17	  const state: Record<string, { dir: string; findings: number; summary: any }> = o.resume && existsSync(stateFile) ? JSON.parse(readFileSync(stateFile, "utf8")) : {};
    18	  mkdirSync(RUNS_DIR, { recursive: true });
    19	  console.log(`sweep ${o.tool.id}: ${rules.length} rules (${Object.keys(state).length} already done)`);
    20	  let i = 0;
    21	  for (const r of rules) {
    22	    i++;
    23	    if (state[r.rule]) continue;
    24	    console.log(`\n[${i}/${rules.length}] ${r.rule}`);
    25	    try {
    26	      const h = await hunt({ tool: o.tool, rule: r.rule, n: o.n, rounds: o.rounds, unsafe: o.unsafe, seed: i });
    27	      const findings = h.results.filter((x) => x.findings.some((f) => f.kind !== "disputed")).length;
    28	      state[r.rule] = { dir: h.dir, findings, summary: h.summary };
    29	    } catch (e) {
    30	      console.log(`  failed: ${String(e).split("\n")[0].slice(0, 160)}`);
    31	      state[r.rule] = { dir: "", findings: -1, summary: { error: String(e).slice(0, 200) } };
    32	    }
    33	    writeFileSync(stateFile, JSON.stringify(state, null, 1));
    34	  }
    35	  const withFindings = Object.entries(state).filter(([, v]) => v.findings > 0);
    36	  console.log(`\nsweep done: ${withFindings.length} rule(s) with oracle-backed findings:\n${withFindings.map(([k, v]) => `  ${k}: ${v.findings} (${v.dir})`).join("\n")}`);
    37	}

