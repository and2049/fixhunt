    24	  predicted: Prediction;
    25	  before: { diagnostics: Diagnostic[]; run: Snap; checkOk: boolean };
    26	  after?: { changed: boolean; diagnostics: Diagnostic[]; run: Snap; checkOk: boolean; diff: string };
    27	  findings: Finding[];
