    33	export async function chat(opts: ChatOpts): Promise<{ text: string; usage: Usage; cost: number }> {
    34	  if (!LLM.apiKey) throw new Error("NEBIUS_API_KEY is not set");
    35	  const body: Record<string, unknown> = {
