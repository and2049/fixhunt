    72	export type Scan = { id: string; dir: string; tool: string; version: string; project: string; run: string; rules: number; applied: number; findings: Array<{ rule: string; kind: string; changedFiles: string[]; exitBefore: number | null; exitAfter: number | null }>; when: string };
