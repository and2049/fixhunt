        fix = mapped !== undefined && (FIX_KINDS as readonly string[]).includes(mapped) ? (mapped as Diagnostic["fix"]) : p.fixPresent && path(d, p.fixPresent) != null ? asFixKind(p.fixPresentKind, "unknown") : "none";
