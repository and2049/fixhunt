   185	
   186	  async lint(file: string, rule: string, cwd: string) {
   187	    const l = this.spec.lint;
   188	    const r = await exec(this.render(l.cmd, { ...this.ruleCtx(rule), file, dir: cwd }), { cwd, timeoutMs: l.timeoutMs ?? 120_000, env: this.env() });
   189	    const { diagnostics, invalid } = this.parseDiagnostics(l.parse, r, rule);
   190	    return { diagnostics, crashed: invalid || this.crashed(r, l.crash), raw: r };
   191	  }
   192	
   193	  async fix(file: string, rule: string, cwd: string, unsafe: boolean) {
   194	    const f = this.spec.fix;
   195	    const cmd = this.render(f.cmd, { ...this.ruleCtx(rule), file, dir: cwd });
   196	    if (unsafe && f.unsafeArgs) cmd.splice(cmd.length - 1, 0, ...f.unsafeArgs); // before the file argument
   197	    const r = await exec(cmd, { cwd, timeoutMs: f.timeoutMs ?? 120_000, env: this.env() });
   198	    return { crashed: this.crashed(r, f.crash), raw: r };
   199	  }
   200	
   201	  async check(file: string, cwd: string) {
   202	    return exec(this.render(this.spec.check.cmd, { file, dir: cwd }), { cwd, timeoutMs: this.spec.check.timeoutMs ?? 60_000, env: this.env() });
   203	  }
   204	
   205	  async run(file: string, cwd: string) {
   206	    const ru = this.spec.run;
   207	    const ctx = { file, dir: cwd, exe: file.replace(/\.[^.]+$/, "") + ".bin" };
   208	    const env = this.env(ru.env);
   209	    const image = ru.image ?? this.spec.sandboxImage;
   210	    if (ru.sandboxCmd && image && (await useContree())) {
   211	      return exec(this.render(ru.sandboxCmd, ctx), { cwd, timeoutMs: Math.max(ru.timeoutMs ?? 5_000, 60_000), isolate: true, image, env });
   212	    }
   213	    if (ru.pre) {
   214	      const c = await exec(this.render(ru.pre, ctx), { cwd, timeoutMs: 120_000, env: this.env() });
   215	      if (c.code !== 0) return { ...c, stderr: "compile failed: " + c.stderr };
   216	    }
   217	    return exec(this.render(ru.cmd, ctx), { cwd, timeoutMs: ru.timeoutMs ?? 5_000, isolate: true, image, env });
   218	  }
   219	
   220	  reproCommands(rule: string, file: string, unsafe: boolean): string[] {
   221	    const ctx = { ...this.ruleCtx(rule), file, unsafe: unsafe ? " " + (this.spec.fix.unsafeArgs ?? []).join(" ") : "", exe: file.replace(/\.[^.]+$/, "") + ".bin" };
   222	    const lines = this.spec.repro ?? [this.render(this.spec.run.cmd, ctx).join(" "), this.render(this.spec.fix.cmd, ctx).join(" ") + ctx.unsafe, this.render(this.spec.run.cmd, ctx).join(" ")];
   223	    return lines.map((l) => this.renderStr(l, ctx));
   224	  }
   225	
   226	  /** Rule catalog from the spec's catalog command. */
   227	  async catalog(): Promise<Array<{ rule: string; fixKind: RuleInfo["fixKind"]; languages?: string[]; name?: string; note?: string }>> {
   228	    const c = this.spec.catalog;
   229	    if (!c) throw new Error(`${this.id}: the tool spec has no catalog command`);
   230	    const r = await exec(this.render(c.cmd, {}), { cwd: process.cwd(), timeoutMs: c.timeoutMs ?? 600_000, maxOutput: 64 * 1024 * 1024, env: this.env() });
   231	    if (r.code !== 0) throw new Error(`${this.id}: catalog command failed: ${r.stderr.slice(0, 300)}`);
   232	    const items = path(JSON.parse(r.stdout), c.parse.items);
   233	    const out: Array<{ rule: string; fixKind: RuleInfo["fixKind"]; languages?: string[]; name?: string; note?: string }> = [];
   234	    for (const d of Array.isArray(items) ? items : []) {
   235	      if ((c.parse.skipIf ?? []).some((s) => new RegExp(s.regex, "i").test(text(path(d, s.field))))) continue;
   236	      const rule = text(path(d, c.parse.rule));
   237	      if (!rule) continue;
   238	      let fixKind: RuleInfo["fixKind"] = "unknown";
   239	      if (c.parse.fixKind) fixKind = asFixKind(path(d, c.parse.fixKind));
   240	      else if (c.parse.fixKindFrom) {
   241	        const v = text(path(d, c.parse.fixKindFrom.field));
   242	        fixKind = asFixKind(c.parse.fixKindFrom.map.find((m) => new RegExp(m.regex, "i").test(v))?.kind ?? c.parse.fixKindFrom.default);
   243	      }
   244	      const langs = Array.isArray(c.parse.languages) ? c.parse.languages : c.parse.languages ? path(d, c.parse.languages) : undefined;
   245	      out.push({ rule, fixKind, name: c.parse.name ? text(path(d, c.parse.name)) : undefined, note: c.parse.note ? text(path(d, c.parse.note)) : undefined, languages: Array.isArray(langs) ? langs.map(String) : undefined });
   246	    }
   247	    return out;
   248	  }
   249	}
   250	
   251	export function loadSpec(file: string): SpecTool {
   252	  const spec = JSON.parse(readFileSync(file, "utf8")) as ToolSpec;
   253	  for (const k of ["id", "language", "ext", "version", "rule", "lint", "fix", "check", "run"] as const) if (!(k in spec)) throw new Error(`${file}: tool spec is missing "${k}"`);
   254	  return new SpecTool(spec, file);
   255	}

