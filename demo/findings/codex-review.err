// Catalog helper for the Biome spec: lists every lint rule with its fix label and example languages.
// Reads the rule names from Biome's configuration schema and asks `biome explain` about each one.
import { readFileSync } from "node:fs";
const BIOME = (process.env.FIXHUNT_BIOME ?? "bunx --bun @biomejs/biome").split(/\s+/);
const schema = JSON.parse(readFileSync("node_modules/@biomejs/biome/configuration_schema.json", "utf8"));
const defs = schema.definitions ?? schema.$defs ?? {};
const out: Array<{ rule: string; name: string; fixKind: string; languages: string[] }> = [];
for (const g of ["A11y", "Complexity", "Correctness", "Nursery", "Performance", "Security", "Style", "Suspicious"]) {
  for (const name of Object.keys(defs[g]?.properties ?? {}).filter((k) => k !== "recommended" && k !== "all")) {
    const p = Bun.spawnSync([...BIOME, "explain", name], { stdout: "pipe", stderr: "pipe" });
    const text = new TextDecoder().decode(p.stdout);
    const rule = /Diagnostic category:\s*lint\/([\w/-]+)/.exec(text)?.[1] ?? `${g.toLowerCase()}/${name}`;
    const fix = /^- Fix:\s*(\w+)/m.exec(text)?.[1]?.toLowerCase();
    const languages = [...new Set([...text.matchAll(/```(\w+)/g)].map((m) => m[1].toLowerCase().replace(/^(js|jsx|javascript)$/, "js").replace(/^(ts|tsx|typescript)$/, "ts")))];
    out.push({ rule, name, fixKind: fix === "safe" ? "safe" : fix === "unsafe" ? "unsafe" : p.exitCode === 0 ? "none" : "unknown", languages });
  }
}
console.log(JSON.stringify(out));
// Catalog helper for the ESLint spec: built-in rules with their fixability. ESLint has no safe/unsafe label;
// its rule authoring guide requires autofixes to preserve program behavior, so a fixable rule counts as "safe".
const { builtinRules } = await import("eslint/use-at-your-own-risk");
const out = [...builtinRules.entries()].map(([rule, r]: [string, any]) => ({
  rule, fixKind: r.meta?.fixable ? "safe" : "none", note: r.meta?.fixable ? `${r.meta.fixable} fix` : "no fix", deprecated: !!r.meta?.deprecated, url: r.meta?.docs?.url ?? "",
}));
console.log(JSON.stringify(out));
// Rule lookup helper for the ESLint spec: prints the fixability label and metadata of one built-in rule.
const { builtinRules } = await import("eslint/use-at-your-own-risk");
const id = process.argv[2];
const r: any = builtinRules.get(id);
if (!r) { console.error(`unknown ESLint rule ${id}`); process.exit(1); }
console.log(`Rule: ${id}\nFixable: ${r.meta?.fixable ?? "no"}\nType: ${r.meta?.type ?? "?"}\nDeprecated: ${r.meta?.deprecated ? "yes" : "no"}\nDescription: ${r.meta?.docs?.description ?? ""}\nDocs: ${r.meta?.docs?.url ?? ""}`);
// Tool registry: every *.json in tools/ (and in FIXHUNT_TOOLS, colon-separated extra directories) is a tool.
import { existsSync, readdirSync } from "node:fs";
import { join, resolve } from "node:path";
import { loadSpec, type SpecTool } from "./spec";

let cache: Record<string, SpecTool> | undefined;

export function toolDirs(): string[] {
  const dirs = [resolve("tools"), ...(process.env.FIXHUNT_TOOLS ?? "").split(":").filter(Boolean).map((d) => resolve(d))];
  return dirs.filter((d) => existsSync(d));
}

export function loadTools(extraFiles: string[] = []): Record<string, SpecTool> {
  if (cache && !extraFiles.length) return cache;
  const tools: Record<string, SpecTool> = {};
  for (const dir of toolDirs()) for (const f of readdirSync(dir).filter((f) => f.endsWith(".json")).sort()) {
    try { const t = loadSpec(join(dir, f)); tools[t.id] = t; } catch (e) { console.error(`skipping tool spec ${join(dir, f)}: ${String((e as Error).message ?? e)}`); }
  }
  for (const f of extraFiles) { const t = loadSpec(f); tools[t.id] = t; }
  if (!extraFiles.length) cache = tools;
  return tools;
}

export function getTool(id: string, extraFiles: string[] = []): SpecTool {
  const tools = loadTools(extraFiles);
  const t = tools[id];
  if (!t) throw new Error(`unknown tool "${id}"; available: ${Object.keys(tools).join(", ") || "(none; add a spec to tools/)"}`);
  return t;
}
import type { ExecResult } from "../sandbox";

export type Diagnostic = { rule: string; severity: string; message: string; span?: [number, number] | null; fix?: "safe" | "unsafe" | "unknown" | "none" };

export type RuleInfo = {
  tool: string;
  rule: string; // full id, e.g. complexity/noUselessUndefinedInitialization
  fixKind: "safe" | "unsafe" | "none" | "unknown";
  docs: string; // human text used in the generation prompt
};

export interface Tool {
  id: string;
  language: string; // language id used for hazard catalogs and static screens ("js", "py", "cpp", ...)
  ext: string; // file extension for generated programs
  repo?: string; // upstream "owner/name" on GitHub, for the dedup search
  runnerHint?: string; // how a generated program is run, for the generation prompt
  docsFence?: string; // code-fence language for evidence sheets
  version(): Promise<string>;
  ruleInfo(rule: string): Promise<RuleInfo>;
  /** Diagnostics for one rule on one file. */
  lint(file: string, rule: string, cwd: string): Promise<{ diagnostics: Diagnostic[]; crashed: boolean; raw: ExecResult }>;
  /** Apply fixes for one rule in place. unsafe=true also applies fixes the tool labels unsafe. */
  fix(file: string, rule: string, cwd: string, unsafe: boolean): Promise<{ crashed: boolean; raw: ExecResult }>;
  /** Syntax / type check. */
  check(file: string, cwd: string): Promise<ExecResult>;
  /** Run the program. */
  run(file: string, cwd: string): Promise<ExecResult>;
  /** Copy-pasteable commands that reproduce lint → fix → run for a report. */
  reproCommands(rule: string, file: string, unsafe: boolean): string[];
}
// Runtime configuration. Bun loads .env automatically.

export const MODELS = {
  // cheap tier: minimization proposals, bulk classification
  fast: process.env.FIXHUNT_MODEL_FAST ?? "nvidia/Nemotron-3_5-Lightning",
  // program generation: Lightning ignores constraints and truncates under json_schema, Super follows the brief
  gen: process.env.FIXHUNT_MODEL_GEN ?? "nvidia/nemotron-3-super-120b-a12b",
  // report drafting
  mid: process.env.FIXHUNT_MODEL_MID ?? "nvidia/nemotron-3-super-120b-a12b",
  // judge for disputed cases only
  judge: process.env.FIXHUNT_MODEL_JUDGE ?? "nvidia/Nemotron-3-Ultra-550b-a55b",
} as const;

export const LLM = {
  baseUrl: (process.env.NEBIUS_BASE_URL ?? "https://api.tokenfactory.nebius.com/v1/").replace(/\/?$/, "/"),
  apiKey: process.env.NEBIUS_API_KEY ?? "",
};

export const RUNS_DIR = process.env.FIXHUNT_RUNS_DIR ?? "runs";

export function requireEnv(name: string): string {
  const v = process.env[name];
  if (!v) throw new Error(`${name} is not set (see .env.example)`);
  return v;
}

