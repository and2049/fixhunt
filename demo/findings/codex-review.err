    81	      return { text, usage, cost };
    82	    } catch (e) {
    83	      lastErr = e;
    84	      if (attempt === 3) break;
    85	      await Bun.sleep(1500 * 2 ** attempt);
    86	    }
    87	  }
    88	  throw lastErr instanceof Error ? lastErr : new Error(String(lastErr));
    89	}
