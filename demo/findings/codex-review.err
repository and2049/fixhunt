   106	/** Parse a JSON object out of model text: strips code fences and leading prose, tolerates trailing text. */
   107	export function parseJsonLoose<T>(raw: string): T | undefined {
   108	  const text = raw.trim().replace(/^```(?:json)?\s*|\s*```$/g, "");
   109	  try { return JSON.parse(text) as T; } catch {}
   110	  const start = text.indexOf("{");
   111	  if (start < 0) return undefined;
   112	  // scan for the matching close brace, respecting strings
   113	  let depth = 0, inStr = false, esc = false;
   114	  for (let i = start; i < text.length; i++) {
   115	    const c = text[i];
   116	    if (inStr) { if (esc) esc = false; else if (c === "\\") esc = true; else if (c === '"') inStr = false; continue; }
   117	    if (c === '"') inStr = true;
   118	    else if (c === "{") depth++;
   119	    else if (c === "}") { depth--; if (depth === 0) { try { return JSON.parse(text.slice(start, i + 1)) as T; } catch { return undefined; } } }
   120	  }
   121	  return undefined;
   122	}
