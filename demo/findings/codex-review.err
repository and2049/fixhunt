    42	function sse(live: Live): Response {
    43	  const stream = new ReadableStream({
    44	    start(ctrl) {
    45	      const enc = new TextEncoder();
    46	      const send = (e: HuntEvent) => { try { ctrl.enqueue(enc.encode(`data: ${JSON.stringify(e)}\n\n`)); } catch { /* closed */ } };
    47	      for (const e of live.events) send(e);
    48	      if (live.done) { ctrl.close(); return; }
    49	      const l = (e: HuntEvent) => { send(e); if (e.type === "done" || e.type === "error") { live.listeners.delete(l); try { ctrl.close(); } catch { /* */ } } };
    50	      live.listeners.add(l);
    51	      const ka = setInterval(() => { try { ctrl.enqueue(enc.encode(": keepalive\n\n")); } catch { clearInterval(ka); } }, 15_000);
    52	    },
    53	  });
    54	  return new Response(stream, { headers: { "content-type": "text/event-stream", "cache-control": "no-cache", connection: "keep-alive" } });
    55	}
