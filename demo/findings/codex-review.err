   120	export async function analyzeRule(info: RuleInfo, language: string): Promise<{ analysis: RuleAnalysis; cost: number }> {
   121	  const sys = `You are an expert in ${langName(language)} semantics and in the implementation of linter autofixes. You reason precisely about what a rewrite preserves and what it does not.`;
   122	  const user = `Tool: ${info.tool}. Rule: ${info.rule}. The tool labels the fix: ${info.fixKind}.
   123	
   124	Rule documentation:
   125	---
   126	${info.docs.slice(0, 7000)}
   127	---
   128	
   129	Analyze this rule for autofix testing.
   130	1. summary: one sentence on what the rule flags.
   131	2. firing_shapes: 4-8 concrete ${langName(language)} code shapes (one line each, real code) on which the rule fires. Use the keyword/construct forms shown under the documentation's invalid examples.
   132	3. silent_shapes: 3-5 near-miss shapes on which it must stay silent.
   133	4. fix_description: what the autofix rewrites the code into, precisely.
   134	5. hazards: 8-12 rule-specific ways this exact rewrite could change program behavior, break compilation/parsing, or move/drop comments. Each hazard is one sentence that names the construct and why the rewrite is not equivalent there. Think about scoping, hoisting, evaluation order, side effects, aliasing, types, mode/flags, comments, and interactions with surrounding code. Do not list generic advice.
   135	
   136	Return JSON with keys summary, firing_shapes, silent_shapes, fix_description, hazards.`;
   137	  const r = await chatJson<any>({
   138	    model: MODELS.mid,
   139	    messages: [{ role: "system", content: sys }, { role: "user", content: user }],
   140	    schema: { name: "analysis", schema: ANALYSIS_SCHEMA },
   141	    maxTokens: 4000,
   142	    temperature: 0.4,
   143	    tag: "analyze",
   144	  });
   145	  const a = r.value;
   146	  const analysis: RuleAnalysis = {
   147	    summary: String(a.summary ?? ""),
   148	    firingShapes: strs(a.firing_shapes),
   149	    silentShapes: strs(a.silent_shapes),
   150	    fixDescription: String(a.fix_description ?? ""),
   151	    hazards: strs(a.hazards),
   152	  };
   153	  return { analysis, cost: r.cost };
   154	}
   155	
   156	export async function generatePrograms(
   157	  info: RuleInfo,
   158	  analysis: RuleAnalysis,
   159	  opts: { n: number; language: string; runner: string; seed?: number; feedback?: Feedback; model?: string },
   160	): Promise<{ programs: GenProgram[]; cost: number }> {
   161	  const pool = [...analysis.hazards, ...(HAZARDS[opts.language] ?? [])];
   162	  const picked = pick(pool, Math.min(opts.n, pool.length), opts.seed ?? Date.now());
   163	  const sys = `You are an expert in ${langName(opts.language)} semantics and in linter autofix bugs. You write small, deterministic, self-checking programs that sit on the semantic edge cases of one lint rule, to test whether the rule's automatic fix preserves program behavior. You write ordinary application code: the program never mentions linting, rules, fixes, "before" or "after".`;
   164	  const fb = opts.feedback
   165	    ? `
   166	Feedback from the previous round:
   167	${opts.feedback.silent.length ? `- These programs did NOT trigger the rule although they were meant to; the rule only fires on the firing shapes below, so use those shapes literally:\n${opts.feedback.silent.map((s) => "  * " + s).join("\n")}` : ""}
   168	${opts.feedback.invalid.length ? `- These programs failed to parse or were not deterministic; write valid, deterministic code:\n${opts.feedback.invalid.map((s) => "  * " + s).join("\n")}` : ""}
   169	${opts.feedback.fixOk.length ? `- These programs triggered the rule and the fix preserved behavior; do not repeat them, push harder on the hazards:\n${opts.feedback.fixOk.map((s) => "  * " + s).join("\n")}` : ""}
   170	`
   171	    : "";
   172	  const user = `Tool: ${info.tool}. Rule: ${info.rule} — ${analysis.summary}
   173	The fix rewrites: ${analysis.fixDescription}
   174	
   175	The rule fires on these shapes (use them literally, adapted to the hazard):
   176	${analysis.firingShapes.map((s) => "  " + s).join("\n")}
   177	It stays silent on:
   178	${analysis.silentShapes.map((s) => "  " + s).join("\n")}
   179	${fb}
   180	Write ${opts.n} programs, one per hazard below, in order:
   181	${picked.map((h, i) => `${i + 1}. ${h}`).join("\n")}
   182	
   183	Requirements for every program:
   184	- Self-contained ${langName(opts.language)}, runnable with "${opts.runner}". No imports beyond the standard library, no network, no randomness, no timers, no clock, no environment or argv. ${opts.language === "py" ? "Files may be created only in the current directory and must be removed at the end." : "No filesystem access."}
   185	- Deterministic output: print a short trace of the values that matter, including the results of the code the rule would rewrite. Catch expected exceptions and print their type and message.
   186	- At most 30 lines. Only comments that are part of the hazard.
   187	- The trace must depend on the rewritten code so that a behavior change shows up in the output.
   188	- Contain one or two spots where the rule fires (expect_trigger=true), unless the hazard is about a near-miss (expect_trigger=false).
   189	- Make the construct the rule rewrites interact with the surrounding code: loops that re-enter it, later re-declarations, closures capturing it, side effects in its arguments, comments attached to it.
   190	
   191	Return JSON: {"programs":[{"title":"...", "hazard":"...", "expect_trigger":true, "code":"..."}]}`;
   192	  const r = await chatJson<{ programs: Array<{ title: string; hazard: string; expect_trigger: boolean; code: string }> }>({
   193	    model: opts.model ?? MODELS.gen,
   194	    messages: [{ role: "system", content: sys }, { role: "user", content: user }],
   195	    // json_schema mode truncates Nemotron 3.5 Lightning to a single array item; plain JSON parses fine
   196	    schema: process.env.FIXHUNT_GEN_SCHEMA === "1" ? { name: "programs", schema: PROGRAMS_SCHEMA } : undefined,
   197	    maxTokens: 14_000,
   198	    temperature: 0.9,
   199	    tag: "generate",
   200	  });
   201	  const programs = (r.value.programs ?? [])
   202	    .filter((p) => p && typeof p.code === "string" && p.code.trim())
   203	    .map((p, i) => ({
   204	      id: `p${String(i + 1).padStart(3, "0")}`,
   205	      title: String(p.title ?? "").slice(0, 120),
   206	      hazard: String(p.hazard ?? picked[i] ?? "").slice(0, 200),
   207	      code: unescapeCode(p.code).replace(/\r\n/g, "\n").trimEnd() + "\n",
   208	      expectTrigger: p.expect_trigger !== false,
   209	    }));
   210	  return { programs, cost: r.cost };
   211	}
   212	
   213	/** Cheap static screens for generated programs; returns a reason if the program must be rejected. */
   214	export function screenProgram(language: string, code: string): string | undefined {
   215	  const bad: Array<[RegExp, string]> = language === "js"
   216	    ? [
   217	        [/\bMath\.random\b/, "uses Math.random"],
   218	        [/\b(?:Date\.now|new Date)\b/, "uses the clock"],
   219	        [/\b(?:setTimeout|setInterval|setImmediate|queueMicrotask)\b/, "uses timers"],
   220	        [/\b(?:require|import)\s*\(?\s*['"]/, "imports a module"],
   221	        [/\bprocess\.(?:argv|env|stdin)\b/, "reads process state"],
   222	        [/^\s*print\s*\(/m, "calls print() (not JavaScript)"],
   223	      ]
   224	    : language === "cpp"
   225	      ? [
   226	          [/\b(?:rand|srand|random_device|std::chrono|time\(|clock\()/, "uses randomness or the clock"],
   227	          [/\b(?:std::thread|pthread|fork\(|system\(|popen\(|getenv\()/, "uses threads, processes or the environment"],
   228	          [/\b(?:std::cin|getchar|scanf|argv)\b/, "reads input"],
   229	          [/\b(?:std::ifstream|std::ofstream|fopen|std::filesystem)\b/, "uses the filesystem"],
   230	        ]
   231	    : language === "py"
   232	      ? [
   233	          [/\bimport\s+random\b|\bfrom\s+random\b/, "uses random"],
   234	          [/\b(?:time\.time|time\.perf_counter|datetime\.now|datetime\.today)\b/, "uses the clock"],
   235	          [/\binput\s*\(/, "reads stdin"],
   236	          [/\bsys\.argv\b|\bos\.environ\b/, "reads process state"],
   237	          [/\b(?:subprocess|socket|urllib|requests|http\.client)\b/, "uses network or subprocess"],
   238	        ]
   239	      : [];
   240	  for (const [re, why] of bad) if (re.test(code)) return why;
   241	  return undefined;
   242	}
   243	
   244	/** Models sometimes double-escape newlines inside the JSON string; recover when the code has no real line breaks. */
   245	function unescapeCode(code: string): string {
   246	  if (code.includes("\n") || !code.includes("\\n")) return code;
   247	  return code.replace(/\\n/g, "\n").replace(/\\t/g, "\t").replace(/\\"/g, '"');
   248	}
   249	
   250	function strs(x: unknown): string[] {
   251	  return Array.isArray(x) ? x.map((s) => String(s)).filter(Boolean) : [];
   252	}
   253	
   254	function langName(l: string) {
   255	  return l === "js" ? "JavaScript" : l === "py" ? "Python" : l === "cpp" ? "C++ (C++20, single translation unit, standard library only, prints with std::printf or std::cout, returns 0)" : l;
   256	}
   257	
   258	function pick<T>(arr: T[], n: number, seed: number): T[] {
   259	  const a = [...arr];
   260	  let s = seed >>> 0 || 1;
   261	  for (let i = a.length - 1; i > 0; i--) {
   262	    s = (s * 1664525 + 1013904223) >>> 0;
   263	    const j = s % (i + 1);
   264	    [a[i], a[j]] = [a[j], a[i]];
   265	  }
   266	  return a.slice(0, n);
   267	}
     1	// Stage 6: DEDUP. Search upstream issues (GitHub) and the web (Tavily) for the same symptom.
     2	import { chatJson } from "./llm";
     3	import { MODELS } from "./config";
     4	
     5	export type Hit = { source: "github" | "tavily"; title: string; url: string; state?: string; snippet?: string };
     6	export type DedupResult = { queries: string[]; hits: Hit[]; verdicts: Array<{ url: string; relation: "duplicate" | "related" | "unrelated"; why: string }>; cost: number };
     7	
     8	// Upstream repositories come from the tool spec (`repo`); `tool` below is the "owner/name" string.
     9	
    10	async function ghToken(): Promise<string | undefined> {
    11	  if (process.env.GITHUB_TOKEN) return process.env.GITHUB_TOKEN;
    12	  try {
    13	    const p = Bun.spawn(["gh", "auth", "token"], { stdout: "pipe", stderr: "ignore" });
    14	    const t = (await new Response(p.stdout).text()).trim();
    15	    return (await p.exited) === 0 && t ? t : undefined;
    16	  } catch { return undefined; }
    17	}
    18	
    19	export async function searchGithub(repo: string | undefined, q: string): Promise<Hit[]> {
    20	  if (!repo) return [];
    21	  const token = await ghToken();
    22	  const url = `https://api.github.com/search/issues?per_page=10&q=${encodeURIComponent(`repo:${repo} is:issue ${q}`)}`;
    23	  const res = await fetch(url, { headers: { accept: "application/vnd.github+json", ...(token ? { authorization: `Bearer ${token}` } : {}) }, signal: AbortSignal.timeout(20_000) });
    24	  if (!res.ok) return [];
    25	  const data: any = await res.json();
    26	  return (data.items ?? []).map((it: any) => ({ source: "github" as const, title: it.title, url: it.html_url, state: it.state, snippet: (it.body ?? "").slice(0, 300) }));
    27	}
    28	
    29	export async function searchTavily(q: string): Promise<Hit[]> {
    30	  const key = process.env.TAVILY_API_KEY;
    31	  if (!key) return [];
    32	  const res = await fetch("https://api.tavily.com/search", {
    33	    method: "POST",
    34	    headers: { "content-type": "application/json", authorization: `Bearer ${key}` },
    35	    body: JSON.stringify({ query: q, max_results: 8, search_depth: "basic" }),
    36	    signal: AbortSignal.timeout(30_000),
    37	  });
    38	  if (!res.ok) return [];
    39	  const data: any = await res.json();
    40	  return (data.results ?? []).map((r: any) => ({ source: "tavily" as const, title: r.title ?? "", url: r.url, snippet: (r.content ?? "").slice(0, 300) }));
    41	}
    42	
    43	export type DedupInput = { tool: string; repo?: string; rule: string; kind: string; observed: string; repro: string; diff: string };
    44	
    45	export async function dedup(inp: DedupInput): Promise<DedupResult> {
    46	  const { tool, rule } = inp;
    47	  const short = rule.split("/").pop()!;
    48	  let cost = 0;
    49	  const finding = `Tool ${tool}, rule ${rule}. Oracle: ${inp.kind}.\nProgram:\n${inp.repro}\nDiff applied by the fix:\n${inp.diff}\nObserved:\n${inp.observed}`;
    50	  // 1. Ask for search queries that name the construct, not the symptom wording
    51	  let queries = [`${short} fix`];
    52	  try {
    53	    const q = await chatJson<{ queries: string[] }>({
    54	      model: MODELS.mid,
    55	      messages: [
    56	        { role: "system", content: "You write issue-tracker search queries for linter autofix bugs. Queries are 3-8 words naming the rule and the code construct involved (e.g. the statement shape, keyword, or API), never the words 'before', 'after', 'stdout'." },
    57	        { role: "user", content: `${finding}\n\nReturn JSON {"queries":["...","...","..."]} with three distinct queries.` },
    58	      ],
    59	      maxTokens: 300,
    60	      temperature: 0.3,
    61	      tag: "dedup-queries",
    62	    });
    63	    cost += q.cost;
    64	    queries = [...queries, ...(q.value.queries ?? []).map(String).filter(Boolean).slice(0, 3)];
    65	  } catch {}
    66	  // 2. Search GitHub directly plus Tavily restricted to the tracker (the bonus requires a runtime Tavily call)
    67	  const hits: Hit[] = [];
    68	  const seen = new Set<string>();
    69	  const repo = inp.repo;
    70	  for (const q of queries) {
    71	    const gh = await searchGithub(repo, q);
    72	    const tv = await searchTavily(`${q} site:github.com/${repo ?? ""}`);
    73	    for (const h of [...gh, ...tv]) {
    74	      h.url = h.url.replace(/[?#].*$/, "").replace(/\/(commits|files|checks)$/, "");
    75	      if (seen.has(h.url) || !/github\.com\/[^/]+\/[^/]+\/(issues|pull)\/\d+$/.test(h.url)) continue;
    76	      seen.add(h.url);
    77	      hits.push(h);
    78	    }
    79	  }
    80	  if (!hits.length) return { queries, hits, verdicts: [], cost };
    81	  // 3. Triage with the judge model: duplicate means the existing report's own reproducer exercises the same defect
    82	  const r = await chatJson<{ verdicts: Array<{ url: string; relation: string; why: string }> }>({
    83	    model: MODELS.judge,
    84	    messages: [
    85	      { role: "system", content: "You triage bug reports for a linter autofix. Be strict: 'duplicate' only if the existing report describes the same defect, meaning the same rewrite going wrong on the same kind of construct, so that fixing the existing report would also fix the new finding. 'related' means same rule or same class of defect but a different construct or cause. Otherwise 'unrelated'. Titles and snippets are all you have; when a snippet does not show the construct, prefer 'related' over 'duplicate'." },
    86	      { role: "user", content: `New finding:\n${finding}\n\nExisting reports:\n${hits.map((h, i) => `${i + 1}. [${h.source}${h.state ? ", " + h.state : ""}] ${h.title}\n   ${h.url}\n   ${h.snippet?.replace(/\s+/g, " ")}`).join("\n")}\n\nReturn JSON {"verdicts":[{"url":"...","relation":"duplicate|related|unrelated","why":"one sentence naming the construct in the existing report"}]} with one entry per report.` },
    87	    ],
    88	    maxTokens: 3000,
    89	    temperature: 0.1,
    90	    tag: "dedup",
    91	  });
    92	  cost += r.cost;
    93	  const verdicts = (r.value.verdicts ?? []).map((v) => ({ url: String(v.url), relation: (["duplicate", "related", "unrelated"].includes(v.relation) ? v.relation : "unrelated") as any, why: String(v.why ?? "") }));
    94	  return { queries, hits, verdicts, cost };
    95	}
     1	// Stage 6: JUDGE. Ultra grades each oracle-backed finding against the rule documentation. Advisory only:
     2	// the oracle decided that behavior changed; the judge decides whether anyone should care.
     3	import { chatJson } from "./llm";
     4	import { MODELS } from "./config";
     5	import type { Snap } from "./oracles";
     6	
     7	export type Verdict = {
     8	  grade: "real" | "intended-change" | "introspection-only" | "program-bug" | "unclear";
     9	  severity: "high" | "medium" | "low";
    10	  why: string;
    11	  docsQuote?: string;
    12	  differenceSource?: string;
    13	};
    14	
    15	const INTROSPECTION: Array<[RegExp, string]> = [
    16	  [/\.source\b/, "RegExp.prototype.source"], [/\.stack\b/, "error stack text"], [/\.toString\(\)/, "toString of code"], [/Function\.prototype\.toString/, "function source"],
    17	  [/\bnew Error\([^)]*\)\.stack|\.lineNumber\b|\bcolumnNumber\b/, "stack positions"],
    18	  [/inspect\.getsource|inspect\.getsourcelines|\bco_firstlineno\b|\b__code__\b|\blinecache\b|sys\._getframe|\btraceback\b|\.lineno\b|\btb_lineno\b/, "python source/line introspection"],
    19	  [/warnings\.|SyntaxWarning|DeprecationWarning/, "warning text"], [/\bast\.(parse|dump|unparse)\b|\bdis\.dis\b|\bcompile\(/, "program inspects its own AST/bytecode"],
    20	];
    21	const ENVIRONMENT: Array<[RegExp, string]> = [
    22	  [/__dirname|__filename|\brequire\(|module\.exports|import\.meta/, "CommonJS/ESM module environment"], [/process\.(env|argv|platform|version)/, "process environment"],
    23	  [/os\.environ|sys\.argv|sys\.version|platform\./, "python environment"], [/\bimport\s+(vue|react|lodash|numpy|pandas|requests)\b|from\s+(vue|react|numpy|pandas)\s+import/, "third-party import"],
    24	];
    25	
    26	function hints(code: string, before?: Snap): string[] {
    27	  const out: string[] = [];
    28	  for (const [re, label] of INTROSPECTION) if (re.test(code)) out.push(`program reads ${label}`);
    29	  for (const [re, label] of ENVIRONMENT) if (re.test(code)) out.push(`program depends on ${label}`);
    30	  if (before && !before.timedOut && before.code !== 0) out.push(`the program already exited with status ${before.code} BEFORE the fix (${before.stderr1 || "no stderr"})`);
    31	  return out;
    32	}
    33	
    34	const SYSTEM = `You review candidate bugs in linter autofixes. A program was linted, the tool's automatic fix was applied, and a model-free oracle observed that the program's behavior changed (different stdout, exit status or error) or that the fixed file no longer parses. The oracle is never wrong about the difference. Your job is to classify WHY it differs, using the rule documentation.
    35	
    36	Grades, in the order you must consider them:
    37	1. "program-bug": the comparison is meaningless. Either the program already failed before the fix for a reason unrelated to the rewrite, or the difference comes from the execution environment rather than the rewrite: module system (CommonJS vs ES modules, __dirname vs import.meta), a missing third-party package, platform or interpreter specifics, undefined behavior, nondeterminism.
    38	2. "introspection-only": the only thing that differs is text that mirrors the rewritten source itself: RegExp.prototype.source or toString() of the rewritten literal, Function.prototype.toString, error stack line/column numbers, inspect.getsource, co_firstlineno, warning messages that quote the source, comments. Any rewrite changes these; they are not behavior.
    39	3. "intended-change": the difference is exactly the semantic change the rule exists to make, as stated or clearly implied by the documentation. Examples: a rule that rewrites 'x is 5' to 'x == 5' because identity comparison with a literal is always a mistake (so equality instead of identity is the point), a rule that replaces a deprecated alias with its replacement (so the deprecation warning disappears and the replacement's behavior applies), a rule that turns '\\d' in a normal string into a raw string (so the SyntaxWarning disappears). The program only demonstrates that the rule did what it documents, even if the program depended on the old behavior. Not a bug in the fix.
    40	4. "real": none of the above. The documentation presents the rewrite as equivalent (or says nothing about this construct), the construct is plausible in ordinary code, and a user who applies the fix gets different runtime behavior or a file that no longer parses. The fix should not be labelled safe for this construct, or should not be offered.
    41	5. "unclear": the evidence does not let you decide.
    42	
    43	Severity: high = silent wrong results, data loss or a crash in plausible code; medium = needs an unusual but legal construct, or an exception where the program previously succeeded; low = contrived construct.
    44	
    45	Reason from the diff, the two outputs and the documentation. The hints are computed mechanically from the program text; weigh them, do not treat them as the answer. Return JSON:
    46	{"docs_quote": "<up to 25 words from the documentation that describe the rewrite, or 'none'>", "difference_source": "runtime-semantics" | "source-text-introspection" | "environment" | "pre-existing-failure", "grade": "...", "severity": "...", "why": "two or three sentences naming the construct and the reason"}`;
    47	
    48	const FEW_SHOT = `Worked examples (abbreviated):
    49	- ruff F632 rewrites 'x is []' to 'x == []'; output changes from False to True. Docs: "comparisons to literals using is always evaluate to False". grade: intended-change.
    50	- Biome noAdjacentSpacesInRegex rewrites /a  b/ to /a {2}b/; the program prints re.source. grade: introspection-only.
    51	- Biome noGlobalDirnameFilename rewrites __dirname to import.meta.dirname; the program runs as CommonJS and now throws. grade: program-bug (environment).
    52	- ruff FURB103 rewrites 'flag and f.write(x)' inside 'with open(p, "w")' to 'Path(p).write_text(x)'; the guard is gone, the file is written when flag is False. Docs present the rewrite as equivalent. grade: real, high.
    53	- Biome noUselessElse hoists 'let x' out of an else block into a scope that already declares x; the file no longer parses. grade: real, high.
    54	- Biome noPrototypeBuiltins rewrites obj.hasOwnProperty(k) to Object.hasOwn(obj, k); the program gave obj its own hasOwnProperty property. The docs say the rule exists because the method can be shadowed or missing, so bypassing it is the point. grade: intended-change.
    55	- Biome useNumberNamespace rewrites parseInt(x) to Number.parseInt(x) inside a function whose parameter is named Number. The docs say nothing about a shadowed Number; the fix assumes the global. grade: real, medium.
    56	- A program whose "before" run already exits non-zero with an error unrelated to the rewrite, and whose "after" run differs only because that failure moved or disappeared. grade: program-bug.`;
    57	
    58	export async function judgeFinding(inp: { tool: string; rule: string; fixKind: string; kind: string; observed: string; repro: string; diff: string; docs?: string; before?: Snap; after?: Snap }): Promise<{ verdict: Verdict; cost: number }> {
    59	  const h = hints(inp.repro, inp.before);
    60	  const r = await chatJson<{ docs_quote?: string; difference_source?: string; grade: string; severity: string; why: string }>({
    61	    model: MODELS.judge,
    62	    messages: [
    63	      { role: "system", content: SYSTEM + "\n\n" + FEW_SHOT },
    64	      { role: "user", content: `Tool ${inp.tool}, rule ${inp.rule}, fix labelled ${inp.fixKind}. Oracle: ${inp.kind}.\n\nRule documentation:\n${(inp.docs ?? "(none)").slice(0, 3500)}\n\nProgram (before the fix):\n${inp.repro}\n\nDiff applied by the fix:\n${inp.diff}\n\nObserved:\n${inp.observed}\n\nMechanical hints: ${h.length ? h.join("; ") : "none"}` },
    65	    ],
    66	    maxTokens: 900,
    67	    temperature: 0.1,
    68	    tag: "judge",
    69	  });
    70	  const g = String(r.value.grade ?? "unclear");
    71	  const sv = String(r.value.severity ?? "low");
    72	  return {
    73	    verdict: {
    74	      grade: (["real", "intended-change", "introspection-only", "program-bug", "unclear"].includes(g) ? g : "unclear") as Verdict["grade"],
    75	      severity: (["high", "medium", "low"].includes(sv) ? sv : "low") as Verdict["severity"],
    76	      why: String(r.value.why ?? ""),
    77	      docsQuote: r.value.docs_quote ? String(r.value.docs_quote) : undefined,
    78	      differenceSource: r.value.difference_source ? String(r.value.difference_source) : undefined,
    79	    },
    80	    cost: r.cost,
    81	  };
    82	}

