    13	
    14	export type FindingReport = { programId: string; kind: string; safeLabel: boolean; minimized: string; lines: { before: number; after: number }; reportPath: string; duplicates: Array<{ url: string; relation: string }>; verdict?: Verdict; dedup?: DedupResult; evidence?: Evidence; minimizer?: { evaluations: number; proposal?: string } };
