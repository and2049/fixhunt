    57	export async function evaluateProgram(
    58	  tool: Tool,
    59	  info: RuleInfo,
    60	  dir: string,
    61	  p: { id: string; title: string; hazard: string; code: string; expectTrigger: boolean },
    62	  opts: { unsafe: boolean },
    63	): Promise<ProgramResult> {
    64	  const wd = join(dir, p.id);
