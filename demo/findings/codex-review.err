    68	      const desc = `${p.title} (${p.hazard.slice(0, 80)})`;
    69	      const kinds = r.findings.map((f) => f.kind);
    70	      let status: Extract<HuntEvent, { type: "program" }>["status"];
    71	      let detail: string;
