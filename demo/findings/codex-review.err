     1	// Scan: point the oracles at a real repository. For every rule the tool labels safe, apply that rule's fix to
     2	// a copy of the project and run the project's own command (tests, a script) before and after, in a sandbox.
     3	// A finding is a rule whose fix changed the command's output or exit status.
     4	import { cpSync, existsSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
     5	import { join, resolve } from "node:path";
     6	import { catalogFor, sweepRules } from "./catalog";
     7	import { RUNS_DIR } from "./config";
     8	import { exec, sandboxInfo, type ExecResult } from "./sandbox";
     9	import type { SpecTool } from "./tools/spec";
    10	
    11	export type ScanOpts = { tool: SpecTool; dir: string; run: string; rules?: string[]; unsafe?: boolean; limit?: number; image?: string; net?: boolean; timeoutMs?: number; parallel?: number; exclude?: string[] };
    12	export type ScanFinding = { rule: string; fixKind: string; changedFiles: string[]; diff: string; before: Snap; after: Snap; kind: "fix-changes-behavior" | "fix-breaks-build" };
    13	type Snap = { stdout: string; stderr: string; code: number | null; timedOut: boolean };
    14	
    15	const DEFAULT_EXCLUDE = [".git", "node_modules", ".venv", "venv", "__pycache__", ".pytest_cache", ".ruff_cache", ".mypy_cache", "dist", "build", "target", ".tox", ".nox"];
    16	
    17	function snap(r: ExecResult): Snap { return { stdout: r.stdout, stderr: r.stderr.split("\n").slice(-20).join("\n"), code: r.code, timedOut: r.timedOut }; }
    18	function norm(s: Snap): string {
    19	  // Drop timings and temp paths so a re-run compares equal
    20	  // Timings, temp paths, addresses and file:line positions (a fix that deletes a line shifts every later line number)
    21	  const scrub = (t: string) => t.replace(/\d+(\.\d+)?s\b/g, "Ns").replace(/in \d+\.\d+s/g, "in Ns").replace(/\/tmp\/[\w.-]+/g, "/tmp/X").replace(/0x[0-9a-f]+/g, "0xX").replace(/(\.\w{1,5}):\d+(:\d+)?/g, "$1:N").replace(/\bline \d+/g, "line N");
    22	  return `${s.code}|${s.timedOut}|${scrub(s.stdout)}`;
    23	}
    24	
    25	export async function scan(o: ScanOpts) {
    26	  const src = resolve(o.dir);
    27	  if (!existsSync(src)) throw new Error(`no such directory: ${src}`);
    28	  const exclude = [...DEFAULT_EXCLUDE, ...(o.exclude ?? [])];
    29	  const image = o.image ?? o.tool.spec.sandboxImage;
    30	  const runCmd = ["sh", "-c", o.run];
    31	  const runOpts = { timeoutMs: o.timeoutMs ?? 600_000, isolate: true, image, net: o.net ?? true, recursive: true, exclude, maxOutput: 2 * 1024 * 1024 };
    32	  const scanId = `${new Date().toISOString().replace(/[:.]/g, "-")}-scan-${o.tool.id}`;
    33	  const out = join(RUNS_DIR, scanId);
    34	  mkdirSync(out, { recursive: true });
    35	  const version = await o.tool.version();
    36	  console.log(`scan ${scanId}\n  ${o.tool.id} ${version} on ${src}\n  command: ${o.run}\n  sandbox: ${await sandboxInfo(o.net ?? true)}${image ? ` (${image})` : ""}`);
    37	
    38	  // Baseline copy and baseline run (twice: the command itself must be deterministic)
    39	  const base = join(out, "base");
    40	  copyTree(src, base, exclude);
    41	  const b1 = snap(await exec(runCmd, { cwd: base, ...runOpts }));
    42	  if (/^sandbox failure:/.test(b1.stderr)) throw new Error(b1.stderr);
    43	  const b2 = snap(await exec(runCmd, { cwd: base, ...runOpts }));
