     9	  | "fix-breaks-syntax"   // O2
    10	  | "fix-changes-behavior" // O3
    11	  | "fix-not-fixpoint"    // O4 rule still fires after its own fix
    12	  | "fix-introduces-diagnostic" // O4 new diagnostics of the same rule appear after fix
    13	  | "disputed";           // prediction ≠ observation, no oracle hit → model judge
    14	
    15	export type Finding = { kind: FindingKind; safeLabel: boolean; detail: string };
    16	
    17	export type Prediction = { expectTrigger: boolean };
    18	
    19	export type ProgramResult = {
    20	  id: string;
    21	  title: string;
    22	  hazard: string;
