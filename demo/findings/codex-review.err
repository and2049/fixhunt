     1	// Read model for the dashboard: runs, ranked findings, curated statuses and spend. Pure file reads, cached by mtime.
     2	import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
     3	import { join } from "node:path";
     4	import { RUNS_DIR } from "../config";
     5	import type { FindingReport } from "../pipeline";
     6	import type { ProgramResult } from "../oracles";
     7	import type { RuleInfo } from "../tools/types";
     8	
     9	export type Run = {
    10	  id: string; dir: string; tool: string; ext: string; version: string; rule: RuleInfo; analysis?: any;
    11	  opts?: { n: number; rounds: number; unsafe: boolean; model?: string }; cost: number; summary: Record<string, number>;
    12	  reports: FindingReport[]; results: ProgramResult[]; when: string;
    13	};
    14	
    15	export type Curated = { tool: string; rule: string; name: string; title: string; summary: string; status: "filed" | "candidate" | "known"; issue?: string; examples: string[]; match: { tool: string; rule: string } };
    16	
    17	export type Finding = {
    18	  run: Run; report: FindingReport; result: ProgramResult; grade: string; severity: string; upstream: "duplicate" | "related" | "none"; curated?: Curated; rank: number;
    19	};
    20	
    21	const GRADE_ORDER: Record<string, number> = { real: 0, unclear: 1, unjudged: 2, "intended-change": 3, "introspection-only": 4, "program-bug": 5 };
    22	const SEV_ORDER: Record<string, number> = { high: 0, medium: 1, low: 2, "-": 3 };
    23	
    24	let cache: { key: string; runs: Run[] } | undefined;
    25	
    26	function runKey(): string {
    27	  if (!existsSync(RUNS_DIR)) return "";
    28	  return readdirSync(RUNS_DIR).map((d) => { const f = join(RUNS_DIR, d, "results.json"); return existsSync(f) ? `${d}:${statSync(f).mtimeMs}` : ""; }).join("|");
    29	}
    30	
    31	export function loadRuns(): Run[] {
    32	  const key = runKey();
    33	  if (cache && cache.key === key) return cache.runs;
    34	  const runs: Run[] = [];
    35	  if (existsSync(RUNS_DIR)) for (const d of readdirSync(RUNS_DIR)) {
    36	    const f = join(RUNS_DIR, d, "results.json");
    37	    if (!existsSync(f)) continue;
    38	    try {
    39	      const j = JSON.parse(readFileSync(f, "utf8"));
    40	      const when = d.slice(0, 24).replace(/^(\d{4}-\d\d-\d\d)T(\d\d)-(\d\d)-(\d\d)-(\d{3})Z$/, "$1T$2:$3:$4.$5Z");
    41	      runs.push({ id: d, dir: join(RUNS_DIR, d), tool: j.tool, ext: j.ext ?? "txt", version: j.version, rule: j.rule, analysis: j.analysis, opts: j.opts, cost: j.cost ?? 0, summary: j.summary ?? {}, reports: j.reports ?? [], results: j.results ?? [], when });
    42	    } catch { /* partial write in progress */ }
    43	  }
    44	  runs.sort((a, b) => b.id.localeCompare(a.id));
    45	  cache = { key, runs };
    46	  return runs;
    47	}
    48	
    49	export function loadCurated(): Curated[] {
    50	  try { return JSON.parse(readFileSync("data/curated.json", "utf8")); } catch { return []; }
    51	}
    52	
    53	export function findings(runs = loadRuns(), curated = loadCurated()): Finding[] {
    54	  const out: Finding[] = [];
    55	  for (const run of runs) for (const report of run.reports) {
    56	    const result = run.results.find((r) => r.id === report.programId);
    57	    if (!result) continue;
    58	    const rel = report.duplicates.map((d) => d.relation);
    59	    const c = curated.find((x) => x.match.tool === run.tool && x.match.rule === run.rule.rule);
    60	    out.push({ run, report, result, grade: report.verdict?.grade ?? "unjudged", severity: report.verdict?.severity ?? "-", upstream: rel.includes("duplicate") ? "duplicate" : rel.includes("related") ? "related" : "none", curated: c, rank: 0 });
    61	  }
    62	  const curatedOrder = (f: Finding) => (f.curated ? ({ filed: 0, candidate: 1, known: 2 } as Record<string, number>)[f.curated.status] : 3);
    63	  out.sort((a, b) => curatedOrder(a) - curatedOrder(b) || (GRADE_ORDER[a.grade] ?? 9) - (GRADE_ORDER[b.grade] ?? 9) || (SEV_ORDER[a.severity] ?? 9) - (SEV_ORDER[b.severity] ?? 9) || Number(b.report.safeLabel) - Number(a.report.safeLabel) || a.run.rule.rule.localeCompare(b.run.rule.rule) || a.run.id.localeCompare(b.run.id));
