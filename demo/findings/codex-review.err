    39	async function minimizeImpl(tool: Tool, info: RuleInfo, dir: string, id: string, code: string, kind: FindingKind, unsafe: boolean, budget: number): Promise<MinimizeResult> {
    40	  let lines = code.replace(/\n+$/, "").split("\n");
    41	  const original = lines.length;
    42	  let evaluations = 0;
    43	  let last: ProgramResult | undefined;
    44	  // Invariant: the reduced program must keep the same finding kind AND the same "before" exit status and
    45	  // error line, so the reduction cannot turn a clean program into one that merely crashes earlier.
    46	  const base = await evaluateProgram(tool, info, dir, { id: `${id}-min0`, title: "min", hazard: "", code, expectTrigger: true }, { unsafe });
    47	  const baseBefore = base.before.run;
    48	  const sameShape = (r: ProgramResult) =>
    49	    !r.error && r.findings.some((f) => f.kind === kind) &&
    50	    r.before.run.code === baseBefore.code && r.before.run.stderr1 === baseBefore.stderr1 && r.before.run.timedOut === baseBefore.timedOut;
    51	  if (!sameShape(base)) return { code, lines: { before: original, after: original }, evaluations: 1, result: base, proposal: "skipped", cost: 0 };
    52	  last = base;
    53	
    54	  // Nemotron 3.5 Lightning proposes a shorter program; ddmin starts from it only if the oracle agrees.
    55	  let proposal: MinimizeResult["proposal"] = "skipped";
    56	  let cost = 0;
    57	  if (process.env.FIXHUNT_MINIMIZE_PROPOSE !== "0") {
    58	    const observed = base.findings.find((f) => f.kind === kind)?.detail ?? "";
    59	    const prop = await proposeShorter(tool, info, code, kind, observed);
    60	    cost += prop.cost;
    61	    if (prop.code) {
    62	      evaluations++;
    63	      const pr = await evaluateProgram(tool, info, dir, { id: `${id}-prop`, title: "min", hazard: "", code: prop.code, expectTrigger: true }, { unsafe });
    64	      if (sameShape(pr)) { lines = prop.code.replace(/\n+$/, "").split("\n"); last = pr; proposal = "accepted"; }
    65	      else proposal = "rejected";
    66	    }
    67	  }
    68	
    69	  const test = async (cand: string[]): Promise<boolean> => {
    70	    if (evaluations >= budget) return false;
    71	    evaluations++;
    72	    const r = await evaluateProgram(tool, info, dir, { id: `${id}-min${evaluations}`, title: "min", hazard: "", code: cand.join("\n") + "\n", expectTrigger: true }, { unsafe });
    73	    const ok = sameShape(r);
    74	    if (ok) last = r;
    75	    return ok;
    76	  };
    77	
    78	  // ddmin over line chunks
    79	  let n = 2;
    80	  while (lines.length >= 2 && evaluations < budget) {
    81	    const chunk = Math.ceil(lines.length / n);
    82	    let reduced = false;
    83	    for (let i = 0; i < lines.length; i += chunk) {
    84	      const complement = [...lines.slice(0, i), ...lines.slice(i + chunk)];
    85	      if (complement.length === 0) continue;
    86	      if (await test(complement)) {
    87	        lines = complement;
    88	        n = Math.max(n - 1, 2);
    89	        reduced = true;
    90	        break;
    91	      }
    92	    }
    93	    if (!reduced) {
    94	      if (n >= lines.length) break;
    95	      n = Math.min(n * 2, lines.length);
    96	    }
    97	  }
    98	  // final single-line pass, also tries blanking inner whitespace-only lines
    99	  for (let i = lines.length - 1; i >= 0 && evaluations < budget; i--) {
   100	    if (lines.length <= 1) break;
   101	    const cand = [...lines.slice(0, i), ...lines.slice(i + 1)];
   102	    if (await test(cand)) lines = cand;
   103	  }
   104	  return { code: lines.join("\n") + "\n", lines: { before: original, after: lines.length }, evaluations, result: last!, proposal, cost };
   105	}
