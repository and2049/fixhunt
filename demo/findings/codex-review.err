     1	// Run one hand-written program through the oracles (ground-truth checks and demos).
     2	import { mkdirSync, readFileSync } from "node:fs";
     3	import { basename, join } from "node:path";
     4	import { RUNS_DIR } from "./config";
     5	import { evaluateProgram } from "./oracles";
     6	import { processFindings } from "./pipeline";
     7	import type { Tool } from "./tools/types";
     8	
     9	export async function checkFile(tool: Tool, rule: string, file: string, unsafe: boolean, report = false) {
    10	  const info = await tool.ruleInfo(rule);
    11	  const dir = join(RUNS_DIR, "check", `${tool.id}-${info.rule.replace("/", "_")}`);
    12	  mkdirSync(dir, { recursive: true });
    13	  const code = readFileSync(file, "utf8");
    14	  const r = await evaluateProgram(tool, info, dir, { id: basename(file).replace(/\W+/g, "_"), title: basename(file), hazard: "manual", code, expectTrigger: true }, { unsafe });
    15	  console.log(JSON.stringify({ rule: info.rule, fixKind: info.fixKind, fired: r.before.diagnostics.length, changed: r.after?.changed ?? false, findings: r.findings, error: r.error }, null, 2));
    16	  if (r.after?.diff) console.log(r.after.diff);
    17	  if (report && r.findings.some((f) => f.kind !== "disputed")) {
    18	    const version = await tool.version();
    19	    await processFindings(tool, info, version, dir, [r], unsafe);
    20	  }
    21	  return r;
    22	}
     1	// Stage 7: REPORT. Internal evidence sheet per finding, for a human to turn into an upstream issue.
     2	// Nothing is posted anywhere. The model only writes the "why the rewrite is not equivalent" paragraph.
     3	import { chat } from "./llm";
     4	import { MODELS } from "./config";
     5	import type { DedupResult } from "./dedup";
     6	import type { Finding, ProgramResult } from "./oracles";
     7	import type { RuleInfo } from "./tools/types";
     8	import type { Verdict } from "./judge";
     9	
    10	export type ReportInput = {
    11	  tool: string; version: string; info: RuleInfo; finding: Finding; result: ProgramResult;
    12	  minimized: { code: string; lines: { before: number; after: number } };
    13	  dedup: DedupResult; commands: string[]; runner: string; verdict?: Verdict; fence?: string;
    14	};
    15	
    16	export async function writeReport(inp: ReportInput): Promise<{ markdown: string; cost: number; explanation: string }> {
    17	  const { finding, result, info } = inp;
    18	  const explain = await chat({
    19	    model: MODELS.mid,
    20	    messages: [
    21	      { role: "system", content: "You are a compiler engineer explaining, precisely and briefly, why an automatic code rewrite is not semantics-preserving. Plain prose, no headings, no bullet points, at most 120 words. Do not speculate about the tool's implementation." },
    22	      { role: "user", content: `Tool ${inp.tool}, rule ${info.rule}. The fix is labelled ${finding.safeLabel ? "safe" : "unsafe"}.\nProgram:\n${inp.minimized.code}\nDiff applied by the fix:\n${result.after?.diff ?? "(none)"}\nObserved: ${finding.kind}. ${finding.detail}\n\nExplain why the rewritten program behaves differently.` },
    23	    ],
    24	    maxTokens: 500,
    25	    temperature: 0.3,
    26	    tag: "report",
    27	  });
    28	  const dups = inp.dedup.verdicts.filter((v) => v.relation !== "unrelated");
    29	  const md = `# ${inp.tool} ${info.rule}: ${title(finding)}
    30	
    31	Internal evidence sheet generated by fixhunt. Not an issue text. A human re-verifies, checks the duplicates
    32	below, and writes the upstream report in their own words following the project's AI policy.
    33	
    34	- Tool: ${inp.tool} ${inp.version}
    35	- Rule: ${info.rule} (tool labels the fix: ${info.fixKind}${finding.safeLabel ? ", this fix reported as safe" : ""})
    36	- Oracle: ${finding.kind}
    37	- Judge (Nemotron 3 Ultra, advisory): ${inp.verdict ? `${inp.verdict.grade}, severity ${inp.verdict.severity}. ${inp.verdict.why}` : "not run"}
    38	- Program: minimized from ${inp.minimized.lines.before} to ${inp.minimized.lines.after} lines
    39	
    40	## Reproducer
    41	
    42	\`\`\`${inp.fence ?? ""}
    43	${inp.minimized.code.trimEnd()}
    44	\`\`\`
    45	
    46	## Commands
    47	
    48	\`\`\`sh
    49	${inp.commands.join("\n")}
    50	\`\`\`
    51	
    52	## Observed
    53	
    54	${fence(finding.detail)}
    55	
    56	## Diff applied by the fix
    57	
    58	\`\`\`diff
    59	${(result.after?.diff ?? "").trimEnd()}
    60	\`\`\`
    61	
    62	## Why the rewrite is not equivalent (model draft, verify before use)
    63	
    64	${explain.text.trim()}
    65	
    66	## Upstream search
    67	
    68	Queries: ${inp.dedup.queries.map((q) => `"${q}"`).join(", ")}
    69	
    70	${dups.length ? dups.map((v) => `- ${v.relation}: ${v.url}\n  ${v.why}`).join("\n") : "- no duplicate or related report found among " + inp.dedup.hits.length + " hits"}
    71	${inp.dedup.hits.length ? "\n<details><summary>All hits</summary>\n\n" + inp.dedup.hits.map((h) => `- [${h.source}${h.state ? ", " + h.state : ""}] ${h.title} — ${h.url}`).join("\n") + "\n\n</details>" : ""}
    72	`;
    73	  return { markdown: md, cost: explain.cost, explanation: explain.text.trim() };
    74	}
    75	
    76	function title(f: Finding): string {
    77	  switch (f.kind) {
    78	    case "fix-changes-behavior": return "fix changes program behavior";
    79	    case "fix-breaks-syntax": return "fixed output does not parse";
    80	    case "fix-not-fixpoint": return "fix is not a fixpoint";
    81	    case "fix-introduces-diagnostic": return "fix introduces new diagnostics";
    82	    case "tool-crash": return "tool crashes";
    83	    default: return f.kind;
    84	  }
    85	}
    86	function fence(s: string) { return "```\n" + s.trim() + "\n```"; }
     1	// Triage table across all runs: one row per oracle-backed finding, real-graded first.
     2	import { existsSync, readdirSync, readFileSync } from "node:fs";
     3	import { join } from "node:path";
     4	import { RUNS_DIR } from "./config";
     5	
     6	type Row = { tool: string; rule: string; run: string; id: string; kind: string; safe: boolean; grade: string; severity: string; why: string; dups: string[]; report: string };
     7	
     8	export function triageRows(filterTool?: string): Row[] {
     9	  const rows: Row[] = [];
    10	  for (const d of readdirSync(RUNS_DIR)) {
    11	    const f = join(RUNS_DIR, d, "results.json");
    12	    if (!existsSync(f)) continue;
    13	    const run = JSON.parse(readFileSync(f, "utf8"));
    14	    if (filterTool && run.tool !== filterTool) continue;
    15	    for (const rep of run.reports ?? []) {
    16	      rows.push({
    17	        tool: run.tool, rule: run.rule.rule, run: d, id: rep.programId, kind: rep.kind, safe: rep.safeLabel,
    18	        grade: rep.verdict?.grade ?? "unjudged", severity: rep.verdict?.severity ?? "-", why: rep.verdict?.why ?? "",
    19	        dups: (rep.duplicates ?? []).map((x: any) => `${x.relation} ${x.url.replace(/^https:\/\/github\.com\//, "")}`),
    20	        report: rep.reportPath,
    21	      });
    22	    }
    23	  }
    24	  const order: Record<string, number> = { real: 0, unclear: 1, unjudged: 2, "intended-change": 3, "introspection-only": 4, "program-bug": 5 };
    25	  const sev: Record<string, number> = { high: 0, medium: 1, low: 2, "-": 3 };
    26	  rows.sort((a, b) => (order[a.grade] ?? 9) - (order[b.grade] ?? 9) || (sev[a.severity] ?? 9) - (sev[b.severity] ?? 9) || a.rule.localeCompare(b.rule));
    27	  return rows;
    28	}
    29	
    30	export function triageMarkdown(filterTool?: string): string {
    31	  const rows = triageRows(filterTool);
    32	  const counts: Record<string, number> = {};
    33	  for (const r of rows) counts[r.grade] = (counts[r.grade] ?? 0) + 1;
    34	  const lines = [`# Triage (${rows.length} findings: ${Object.entries(counts).map(([k, v]) => `${v} ${k}`).join(", ")})`, ""];
    35	  let current = "";
    36	  for (const r of rows) {
    37	    if (r.grade !== current) { current = r.grade; lines.push(`## ${current}`, ""); }
    38	    lines.push(`- **${r.tool} ${r.rule}** ${r.id} · ${r.kind}${r.safe ? " · labelled safe" : ""} · severity ${r.severity}${r.dups.length ? " · " + r.dups.join(", ") : ""}`);
    39	    if (r.why) lines.push(`  ${r.why}`);
    40	    lines.push(`  [${r.report}](../${r.report})`);
    41	  }
    42	  return lines.join("\n") + "\n";
    43	}
     1	// Judge evaluation against hand labels (data/judge-labels.json: "tool rule" -> expected grade).
     2	// --stored scores the verdicts already in results.json (free); otherwise re-judges live with the current prompt.
     3	import { readFileSync, writeFileSync } from "node:fs";
     4	import { join } from "node:path";
     5	import { judgeFinding, type Verdict } from "./judge";
     6	import { loadRuns } from "./web/data";
     7	
     8	export async function judgeEval(opts: { stored: boolean; limit?: number; only?: string; out?: string }) {
     9	  const labels: Record<string, string> = JSON.parse(readFileSync("data/judge-labels.json", "utf8"));
    10	  const grades = ["real", "intended-change", "introspection-only", "program-bug", "unclear"];
    11	  const matrix: Record<string, Record<string, number>> = {};
    12	  const rows: Array<{ key: string; id: string; expected: string; got: string; why: string }> = [];
    13	  let cost = 0, n = 0;
    14	  const items: Array<{ run: ReturnType<typeof loadRuns>[number]; rep: any; key: string; expected: string }> = [];
    15	  for (const run of loadRuns()) {
    16	    const key = `${run.tool} ${run.rule.rule}`;
    17	    const expected = labels[key];
    18	    if (!expected || (opts.only && !key.includes(opts.only))) continue;
    19	    for (const rep of run.reports) { if (opts.limit && items.length >= opts.limit) break; items.push({ run, rep, key, expected }); }
    20	  }
    21	  n = items.length;
    22	  const verdicts: Array<Verdict | undefined> = new Array(n);
    23	  let next = 0;
    24	  const worker = async () => {
    25	    for (;;) {
    26	      const i = next++; if (i >= n) return;
    27	      const { run, rep } = items[i];
    28	      if (opts.stored) { verdicts[i] = rep.verdict; continue; }
    29	      const ev = rep.evidence;
    30	      try {
    31	        const r = await judgeFinding({ tool: run.tool, rule: run.rule.rule, fixKind: run.rule.fixKind, kind: rep.kind, observed: ev?.observed ?? "", repro: rep.minimized, diff: ev?.diff ?? "", docs: run.rule.docs, before: ev?.before, after: ev?.after });
    32	        verdicts[i] = r.verdict; cost += r.cost;
    33	      } catch (e) { console.log(`judge failed for ${items[i].key} ${rep.programId}: ${String(e).slice(0, 100)}`); }
    34	      const got = verdicts[i]?.grade ?? "unjudged";
    35	      console.log(`${got === items[i].expected ? "ok " : "XX "} ${items[i].key} ${rep.programId}: expected ${items[i].expected}, got ${got}${verdicts[i]?.differenceSource ? ` (${verdicts[i]!.differenceSource})` : ""}`);
    36	    }
    37	  };
    38	  await Promise.all(Array.from({ length: opts.stored ? 1 : 4 }, worker));
    39	  for (let i = 0; i < n; i++) {
    40	    const { key, rep, expected } = items[i];
    41	    const got = verdicts[i]?.grade ?? "unjudged";
    42	    (matrix[expected] ??= {})[got] = (matrix[expected]![got] ?? 0) + 1;
    43	    rows.push({ key, id: rep.programId, expected, got, why: verdicts[i]?.why ?? "" });
    44	  }
    45	  const header = `expected \\ got`.padEnd(32) + grades.map((g) => g.padStart(19)).join("");
    46	  console.log(header);
    47	  let correct = 0;
    48	  for (const e of Object.keys(matrix)) {
    49	    console.log(e.padEnd(32) + grades.map((g) => String(matrix[e][g] ?? 0).padStart(19)).join(""));
    50	    correct += matrix[e][e] ?? 0;
    51	  }
    52	  const realAsReal = matrix.real?.real ?? 0, realTotal = Object.values(matrix.real ?? {}).reduce((a, b) => a + b, 0);
    53	  const notRealAsReal = Object.entries(matrix).filter(([e]) => e !== "real").reduce((a, [, m]) => a + (m.real ?? 0), 0);
    54	  const gotReal = realAsReal + notRealAsReal;
    55	  console.log(`\n${n} findings, accuracy ${(100 * correct / n).toFixed(0)}%, real recall ${realTotal ? (100 * realAsReal / realTotal).toFixed(0) : "-"}%, real precision ${gotReal ? (100 * realAsReal / gotReal).toFixed(0) : "-"}%, cost $${cost.toFixed(3)}`);
    56	  if (opts.out) writeFileSync(opts.out, JSON.stringify({ matrix, rows }, null, 1));
    57	}
// Token Factory Sandboxes (Contree) client: run one command in a fresh, disposable, network-less VM.
