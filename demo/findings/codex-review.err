    87	
    88	async function runLimit(tasks: Array<() => Promise<void>>, limit: number) {
    89	  let next = 0;
    90	  const worker = async () => { for (;;) { const i = next++; if (i >= tasks.length) return; await tasks[i](); } };
    91	  await Promise.all(Array.from({ length: Math.max(1, Math.min(limit, tasks.length)) }, worker));
    92	}
    93	
    94	function scanMarkdown(s: any, findings: ScanFinding[]): string {
    95	  const lines = [`# fixhunt scan: ${s.tool} ${s.version} on ${s.dir}`, "", `Command: \`${s.run}\`. ${s.rules} rule(s) tried, ${s.applied} modified files, ${findings.length} changed the outcome.`, ""];
    96	  for (const f of findings) {
    97	    lines.push(`## ${f.rule}: ${f.kind}`, "", `Files changed: ${f.changedFiles.join(", ")}`, "", `Exit ${f.before.code} → ${f.after.code}${f.after.timedOut ? " (timed out)" : ""}`, "",
