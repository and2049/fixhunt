let whoami: Promise<{ ok: boolean; limits?: SandboxLimits; why?: string }> | undefined;

function headers(): Record<string, string> {
  return { authorization: `Bearer ${LLM.apiKey}`, project: PROJECT, "content-type": "application/json" };

