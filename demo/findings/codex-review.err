   102	function printEvent(e: HuntEvent) {
   103	  switch (e.type) {
   104	    case "start": return console.log(`hunt ${e.runId}\n  ${e.tool} ${e.version}, rule ${e.rule} (fix: ${e.fixKind}), sandbox: ${e.sandbox}`);
   105	    case "analysis": return console.log(`  analysis: ${e.hazards.length} rule-specific hazards, ${e.firingShapes} firing shapes ($${e.cost.toFixed(4)})`);
   106	    case "round": return console.log(`  round ${e.round}: ${e.programs} programs ($${e.cost.toFixed(4)})`);
   107	    case "round-failed": return console.log(`  round ${e.round}: generation failed (${e.error}); skipping round`);
   108	    case "program": return console.log(`    ${e.id} ${e.status === "finding" ? e.kinds.join(",") : e.status === "rejected" || e.status === "invalid" ? `${e.status} (${e.detail.slice(0, 60)})` : e.status}  — ${e.title}`);
   109	    case "log": return console.log(`  ${e.message}`);
   110	    case "report": return console.log(`    ${e.programId} ${e.kind}: ${e.lines.before}→${e.lines.after} lines; judge: ${e.grade ? `${e.grade}/${e.severity}` : "n/a"}; ${e.duplicates.length ? e.duplicates.map((d) => `${d.relation} ${d.url}`).join(", ") : "no upstream match"}`);
   111	    case "done": return console.log(`\n${JSON.stringify(e.summary)}\n  model cost $${e.cost.toFixed(4)}; artifacts in ${RUNS_DIR}/${e.runId}`);
   112	    case "error": return console.log(`  error: ${e.message}`);
   113	  }
   114	}
   115	
   116	function summarize(rs: ProgramResult[]) {
   117	  const s: Record<string, number> = { programs: rs.length, invalid: 0, fired: 0, fixed: 0 };
   118	  for (const r of rs) {
   119	    if (r.error) s.invalid++;
   120	    if (r.before.diagnostics.length) s.fired++;
   121	    if (r.after?.changed) s.fixed++;
   122	    for (const f of r.findings) s[f.kind] = (s[f.kind] ?? 0) + 1;
   123	  }
   124	  return s;
   125	}
