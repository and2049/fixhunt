      const spanV = p.span ? path(d, p.span) : undefined;
      const span: Diagnostic["span"] = Array.isArray(spanV) ? [Number(spanV[0]), Number(spanV[1])] : Number.isFinite(line) ? [line, col] : null;
      let fix: Diagnostic["fix"] = undefined;
