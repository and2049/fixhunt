     1	// Stage 5: MINIMIZE. Line-level delta debugging with the oracle as the test. No model needed.
     2	import { evaluateProgram, type FindingKind, type ProgramResult } from "./oracles";
     3	import type { RuleInfo, Tool } from "./tools/types";
     4	import { withLocalSandbox } from "./sandbox";
     5	import { chat } from "./llm";
     6	import { MODELS } from "./config";
     7	
     8	export type MinimizeResult = { code: string; lines: { before: number; after: number }; evaluations: number; result: ProgramResult; proposal?: "accepted" | "rejected" | "skipped"; cost: number };
     9	
    10	/** Ask the cheap model for a shorter program that keeps the finding; the oracle decides whether to accept it. */
    11	async function proposeShorter(tool: Tool, info: RuleInfo, code: string, kind: FindingKind, observed: string): Promise<{ code?: string; cost: number }> {
    12	  try {
    13	    const r = await chat({
    14	      model: MODELS.fast,
    15	      messages: [
    16	        { role: "system", content: "You shorten test programs. Return only the program text, no explanation, no code fences." },
    17	        { role: "user", content: `Tool ${tool.id}, lint rule ${info.rule}. The tool's automatic fix changed this program's behavior (${kind}): ${observed.slice(0, 400)}
    18	
    19	Rewrite the program to be as short as possible while keeping (1) the exact construct the rule rewrites, (2) the surrounding code that makes the rewrite change behavior, (3) the printed output that shows the difference. Keep it deterministic and self-contained. Do not rename identifiers. Program:
    20	
    21	${code}` },
    22	      ],
    23	      maxTokens: 1200,
    24	      temperature: 0.7, // Lightning ignores line budgets at low temperature; the oracle rejects bad proposals anyway
    25	      tag: "minimize",
    26	    });
    27	    const text = r.text.trim().replace(/^```[a-z]*\n?|\n?```$/g, "").trim() + "\n";
    28	    return { code: text.split("\n").length < code.trimEnd().split("\n").length ? text : undefined, cost: r.cost };
    29	  } catch {
    30	    return { cost: 0 };
    31	  }
    32	}
    33	
    34	/** Reduce `code` while the evaluation still produces a finding of `kind`. */
    35	export function minimize(tool: Tool, info: RuleInfo, dir: string, id: string, code: string, kind: FindingKind, unsafe: boolean, budget = 60): Promise<MinimizeResult> {
    36	  return withLocalSandbox(() => minimizeImpl(tool, info, dir, id, code, kind, unsafe, budget));
    37	}
    38	
    39	async function minimizeImpl(tool: Tool, info: RuleInfo, dir: string, id: string, code: string, kind: FindingKind, unsafe: boolean, budget: number): Promise<MinimizeResult> {
    40	  let lines = code.replace(/\n+$/, "").split("\n");
    41	  const original = lines.length;
    42	  let evaluations = 0;
    43	  let last: ProgramResult | undefined;
    44	  // Invariant: the reduced program must keep the same finding kind AND the same "before" exit status and
    45	  // error line, so the reduction cannot turn a clean program into one that merely crashes earlier.
    46	  const base = await evaluateProgram(tool, info, dir, { id: `${id}-min0`, title: "min", hazard: "", code, expectTrigger: true }, { unsafe });
    47	  const baseBefore = base.before.run;
    48	  const sameShape = (r: ProgramResult) =>
    49	    !r.error && r.findings.some((f) => f.kind === kind) &&
    50	    r.before.run.code === baseBefore.code && r.before.run.stderr1 === baseBefore.stderr1 && r.before.run.timedOut === baseBefore.timedOut;
    51	  if (!sameShape(base)) return { code, lines: { before: original, after: original }, evaluations: 1, result: base, proposal: "skipped", cost: 0 };
    52	  last = base;
    53	
    54	  // Nemotron 3.5 Lightning proposes a shorter program; ddmin starts from it only if the oracle agrees.
    55	  let proposal: MinimizeResult["proposal"] = "skipped";
    56	  let cost = 0;
    57	  if (process.env.FIXHUNT_MINIMIZE_PROPOSE !== "0") {
    58	    const observed = base.findings.find((f) => f.kind === kind)?.detail ?? "";
    59	    const prop = await proposeShorter(tool, info, code, kind, observed);
    60	    cost += prop.cost;
    61	    if (prop.code) {
    62	      evaluations++;
    63	      const pr = await evaluateProgram(tool, info, dir, { id: `${id}-prop`, title: "min", hazard: "", code: prop.code, expectTrigger: true }, { unsafe });
    64	      if (sameShape(pr)) { lines = prop.code.replace(/\n+$/, "").split("\n"); last = pr; proposal = "accepted"; }
    65	      else proposal = "rejected";
    66	    }
    67	  }
    68	
    69	  const test = async (cand: string[]): Promise<boolean> => {
    70	    if (evaluations >= budget) return false;
    71	    evaluations++;
    72	    const r = await evaluateProgram(tool, info, dir, { id: `${id}-min${evaluations}`, title: "min", hazard: "", code: cand.join("\n") + "\n", expectTrigger: true }, { unsafe });
    73	    const ok = sameShape(r);
    74	    if (ok) last = r;
    75	    return ok;
    76	  };
    77	
    78	  // ddmin over line chunks
    79	  let n = 2;
    80	  while (lines.length >= 2 && evaluations < budget) {
    81	    const chunk = Math.ceil(lines.length / n);
    82	    let reduced = false;
    83	    for (let i = 0; i < lines.length; i += chunk) {
    84	      const complement = [...lines.slice(0, i), ...lines.slice(i + chunk)];
    85	      if (complement.length === 0) continue;
    86	      if (await test(complement)) {
    87	        lines = complement;
    88	        n = Math.max(n - 1, 2);
    89	        reduced = true;
    90	        break;
    91	      }
    92	    }
    93	    if (!reduced) {
    94	      if (n >= lines.length) break;
    95	      n = Math.min(n * 2, lines.length);
    96	    }
    97	  }
    98	  // final single-line pass, also tries blanking inner whitespace-only lines
    99	  for (let i = lines.length - 1; i >= 0 && evaluations < budget; i--) {
   100	    if (lines.length <= 1) break;
   101	    const cand = [...lines.slice(0, i), ...lines.slice(i + 1)];
   102	    if (await test(cand)) lines = cand;
   103	  }
   104	  return { code: lines.join("\n") + "\n", lines: { before: original, after: lines.length }, evaluations, result: last!, proposal, cost };
   105	}
     1	// Minimal OpenAI-compatible chat client with JSON-schema output and a spend log.
     2	import { LLM, RUNS_DIR } from "./config";
     3	import { appendFileSync, mkdirSync } from "node:fs";
     4	
     5	export type Msg = { role: "system" | "user" | "assistant"; content: string };
     6	
     7	export type ChatOpts = {
     8	  model: string;
     9	  messages: Msg[];
    10	  schema?: { name: string; schema: Record<string, unknown> };
    11	  maxTokens?: number;
    12	  temperature?: number;
    13	  think?: boolean; // Nemotron reasoning; off by default for structured stages
    14	  tag?: string; // stage name for the spend log
    15	};
    16	
    17	export type Usage = { prompt: number; completion: number; reasoning: number };
    18	
    19	const PRICES: Record<string, [number, number]> = {
    20	  // $ per 1M tokens, input / output; verify against the Token Factory console
    21	  "nvidia/Nemotron-3_5-Lightning": [0.06, 0.24],
    22	  "nvidia/nemotron-3-super-120b-a12b": [0.3, 0.9],
    23	  "nvidia/Nemotron-3-Ultra-550b-a55b": [1, 3],
    24	  "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B": [0.06, 0.24],
    25	};
    26	
    27	export function costOf(model: string, u: Usage): number {
    28	  const p = PRICES[model];
    29	  if (!p) return 0;
    30	  return (u.prompt * p[0] + u.completion * p[1]) / 1e6;
    31	}
    32	
    33	export async function chat(opts: ChatOpts): Promise<{ text: string; usage: Usage; cost: number }> {
    34	  if (!LLM.apiKey) throw new Error("NEBIUS_API_KEY is not set");
    35	  const body: Record<string, unknown> = {
    36	    model: opts.model,
    37	    messages: opts.messages,
    38	    max_tokens: opts.maxTokens ?? 4096,
    39	    temperature: opts.temperature ?? 0.7,
    40	  };
    41	  if (!opts.think) {
    42	    // Both forms are accepted by Token Factory for Nemotron; keep both for safety.
    43	    body.chat_template_kwargs = { enable_thinking: false };
    44	    body.reasoning_effort = "none";
    45	  }
    46	  if (opts.schema) {
    47	    body.response_format = { type: "json_schema", json_schema: { name: opts.schema.name, schema: opts.schema.schema } };
    48	  }
    49	
    50	  let lastErr: unknown;
    51	  for (let attempt = 0; attempt < 4; attempt++) {
    52	    try {
    53	      const res = await fetch(`${LLM.baseUrl}chat/completions`, {
    54	        method: "POST",
    55	        headers: { "content-type": "application/json", authorization: `Bearer ${LLM.apiKey}` },
    56	        body: JSON.stringify(body),
    57	        signal: AbortSignal.timeout(180_000),
    58	      });
    59	      if (res.status === 429 || res.status >= 500) {
    60	        lastErr = new Error(`${res.status} ${await res.text()}`);
    61	        await Bun.sleep(1500 * 2 ** attempt);
    62	        continue;
    63	      }
    64	      if (!res.ok) throw new Error(`LLM ${res.status}: ${await res.text()}`);
    65	      const data: any = await res.json();
    66	      const text: string = data.choices?.[0]?.message?.content ?? "";
    67	      // Token Factory occasionally returns a provider-side failure as the message body; treat it as transient
    68	      if (!text || /^\[ERROR:/.test(text.trim()) || data.choices?.[0]?.finish_reason === "error") {
    69	        lastErr = new Error(`provider error: ${text.slice(0, 200) || "empty completion"}`);
    70	        await Bun.sleep(1500 * 2 ** attempt);
    71	        continue;
    72	      }
    73	      const u = data.usage ?? {};
    74	      const usage: Usage = {
    75	        prompt: u.prompt_tokens ?? 0,
    76	        completion: u.completion_tokens ?? 0,
    77	        reasoning: u.completion_tokens_details?.reasoning_tokens ?? 0,
    78	      };
    79	      const cost = costOf(opts.model, usage);
    80	      logSpend({ ts: new Date().toISOString(), tag: opts.tag ?? "", model: opts.model, ...usage, cost });
    81	      return { text, usage, cost };
    82	    } catch (e) {
    83	      lastErr = e;
    84	      if (attempt === 3) break;
    85	      await Bun.sleep(1500 * 2 ** attempt);
    86	    }
    87	  }
    88	  throw lastErr instanceof Error ? lastErr : new Error(String(lastErr));
    89	}
    90	
    91	export async function chatJson<T>(opts: ChatOpts): Promise<{ value: T; usage: Usage; cost: number }> {
    92	  let usage: Usage = { prompt: 0, completion: 0, reasoning: 0 };
    93	  let cost = 0;
    94	  let last = "";
    95	  for (let attempt = 0; attempt < 3; attempt++) {
    96	    const r = await chat(attempt === 0 ? opts : { ...opts, temperature: Math.min(1, (opts.temperature ?? 0.7) + 0.1 * attempt) });
    97	    usage = { prompt: usage.prompt + r.usage.prompt, completion: usage.completion + r.usage.completion, reasoning: usage.reasoning + r.usage.reasoning };
    98	    cost += r.cost;
    99	    const value = parseJsonLoose<T>(r.text);
   100	    if (value !== undefined) return { value, usage, cost };
   101	    last = r.text;
   102	  }
   103	  throw new Error(`model did not return JSON (${opts.tag}) after 3 attempts: ${last.slice(0, 300)}`);
   104	}
   105	
   106	/** Parse a JSON object out of model text: strips code fences and leading prose, tolerates trailing text. */
   107	export function parseJsonLoose<T>(raw: string): T | undefined {
   108	  const text = raw.trim().replace(/^```(?:json)?\s*|\s*```$/g, "");
   109	  try { return JSON.parse(text) as T; } catch {}
   110	  const start = text.indexOf("{");
   111	  if (start < 0) return undefined;
   112	  // scan for the matching close brace, respecting strings
   113	  let depth = 0, inStr = false, esc = false;
   114	  for (let i = start; i < text.length; i++) {
   115	    const c = text[i];
   116	    if (inStr) { if (esc) esc = false; else if (c === "\\") esc = true; else if (c === '"') inStr = false; continue; }
   117	    if (c === '"') inStr = true;
   118	    else if (c === "{") depth++;
   119	    else if (c === "}") { depth--; if (depth === 0) { try { return JSON.parse(text.slice(start, i + 1)) as T; } catch { return undefined; } } }
   120	  }
   121	  return undefined;
   122	}
   123	
   124	export function logSpend(row: Record<string, unknown>) {
   125	  try {
   126	    mkdirSync(RUNS_DIR, { recursive: true });
   127	    appendFileSync(`${RUNS_DIR}/spend.jsonl`, JSON.stringify(row) + "\n");
   128	  } catch {}
   129	}

