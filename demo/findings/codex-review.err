    26	export async function processFindings(tool: Tool, info: RuleInfo, version: string, dir: string, results: ProgramResult[], unsafe: boolean, prior: FindingReport[] = [], log: (m: string) => void = (m) => console.log("  " + m), onReport?: (r: FindingReport) => void): Promise<{ reports: FindingReport[]; cost: number }> {
    27	  const reports: FindingReport[] = [];
